---
// Page Services : un bloc par groupe (Dépannage, Installation, Rénovation…), avec sa photo.
import Vitrine from './Vitrine.astro';
import TetePage from '../../components/vitrine/TetePage.astro';
import TitreSection from '../../components/vitrine/TitreSection.astro';
import Urgences from '../../components/vitrine/Urgences.astro';
import CadreImage from '../../components/demo/CadreImage.astro';
import Prestations from '../../components/commun/Prestations.astro';
import Garanties from '../../components/commun/Garanties.astro';
import { ancreGroupe } from '../../lib/services';
import type { Site } from '../../lib/schema';
import { lienSite } from '../../lib/liens';

interface Props {
  site: Site;
}
const { site } = Astro.props;
const groupes = site.services.map((g) => ({ ...g, id: ancreGroupe(g.groupe) }));
// Rythme des fonds : le 1er groupe est suivi de la bande ardoise des urgences, puis un groupe
// sur deux passe sur carrelage. Les garanties prennent le carrelage seulement si le dernier
// groupe ne l'a pas déjà (jamais deux bandes identiques à la suite).
const surCarrelage = (i: number) => i > 0 && i % 2 === 0;
const garantiesCarrelage = !surCarrelage(groupes.length - 1);
---

<Vitrine site={site} page="services" titre="Services">
  <TetePage site={site} titre="Services">
    {
      groupes.length > 1 && (
        <ul class="sommaire" aria-label="Groupes de services">
          {groupes.map((g) => (
            <li>
              <a href={`#${g.id}`}>{g.groupe}</a>
            </li>
          ))}
        </ul>
      )
    }
  </TetePage>

  {
    groupes.map((g, i) => {
      const image = g.image ? site.images[g.image] : undefined;
      return (
        <>
          <section class:list={['section-v', 'groupe', { 'surface-carrelage': surCarrelage(i) }]} id={g.id} aria-labelledby={`titre-${g.id}`}>
            <div class:list={['page-v', 'groupe-grille', { 'avec-image': image || g.deroule?.length }]}>
              <div>
                <TitreSection id={`titre-${g.id}`}>{g.groupe}</TitreSection>
                <Prestations items={g.items} class="groupe-liste" />
              </div>
              {(image || g.deroule?.length) && (
                <div class="groupe-cote">
                  {image && (
                    <div class="groupe-photo">
                      <CadreImage site={site} image={image} sizes="(min-width: 64rem) 26rem, 100vw" />
                    </div>
                  )}
                  {g.deroule && g.deroule.length > 0 && (
                    <div class="groupe-deroule">
                      <h3>Comment ça se passe</h3>
                      <ol>
                        {g.deroule.map((etape) => (
                          <li>{etape}</li>
                        ))}
                      </ol>
                    </div>
                  )}
                </div>
              )}
            </div>
          </section>
          {i === 0 && <Urgences site={site} id="urgences-services" />}
        </>
      );
    })
  }

  {
    site.garanties && (
      <section class:list={['section-v', { 'surface-carrelage': garantiesCarrelage }]} aria-labelledby="titre-garanties">
        <div class="page-v">
          <TitreSection id="titre-garanties">Vos garanties</TitreSection>
          <Garanties site={site} />
        </div>
      </section>
    )
  }

  <section class="section-v" aria-labelledby="titre-suite">
    <div class="page-v">
      <TitreSection id="titre-suite">Quel prix prévoir ?</TitreSection>
      {site.tarifs?.mention && <p class="suite-texte">{site.tarifs.mention}</p>}
      <p class="suite-liens">
        {site.pages.includes('tarifs') && <a class="lien-v" href={lienSite(site, 'tarifs')}>Voir les tarifs</a>}
        {
          site.pages.includes('contact') && (
            <a class="lien-v" href={`${lienSite(site, 'contact')}#devis`}>
              Demander un devis
            </a>
          )
        }
      </p>
    </div>
  </section>
</Vitrine>

<style>
  .sommaire {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-3);
    margin-top: var(--espace-2);
    list-style: none;
    padding: 0;
  }

  .sommaire a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--couleur-lien);
    font-weight: 600;
  }

  .groupe-grille {
    display: grid;
    gap: var(--espace-3);
  }

  .groupe-liste :global(.pr-nom) {
    font-size: var(--taille-1);
  }

  .groupe-cote {
    display: grid;
    gap: var(--espace-3);
    align-content: start;
  }

  .groupe-photo {
    max-width: 26rem;
  }

  .groupe-deroule {
    max-width: 26rem;
  }

  .groupe-deroule h3 {
    margin-bottom: var(--espace-1);
    font-size: var(--taille-1);
  }

  /* Étapes reliées par un filet cuivre vertical : un bout de conduite, pas de numéros décoratifs */
  .groupe-deroule ol {
    list-style: none;
    padding: 0 0 0 var(--espace-2);
    border-left: 2px solid var(--cuivre);
  }

  .groupe-deroule li {
    color: var(--couleur-texte-secondaire);
    line-height: 1.5;
  }

  .groupe-deroule li + li {
    margin-top: var(--espace-1);
  }

  @media (min-width: 64rem) {
    .groupe-grille.avec-image {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: var(--espace-5);
      align-items: start;
    }

    .groupe-liste {
      max-width: 38rem;
    }
  }

  .suite-texte {
    max-width: 36rem;
    font-size: var(--taille-1);
  }

  .suite-liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--espace-3);
    margin-top: var(--espace-1);
  }
</style>
