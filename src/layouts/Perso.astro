---
// Mise en page du site personnel (accueil, modèles, tarifs, contact, pages légales).
// Direction « annuaire » : voir .impeccable/surfaces/ et docs/briefs/accueil.md.
import '../styles/base.css';
import '../styles/perso.css';
import EnTete from '../components/perso/EnTete.astro';
import PiedPerso from '../components/perso/PiedPerso.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { MOI, NOM, PUBLIE, aCompleter, urlLogo, villesFr, prixFr } from '../lib/moi';
import { RACINE } from '../lib/images.mjs';
import { telInternational } from '../lib/typo-fr';
import { LIEN_ACCUEIL, LIEN_GRILLE, LIEN_TARIFS, LIEN_CONTACT, IMAGE_PARTAGE_PERSO } from '../lib/liens';

interface Props {
  /** Titre de la page ; absent sur l'accueil. */
  titre?: string;
  description: string;
}
const { titre, description } = Astro.props;
const METIER = 'Sites internet pour commerçants et artisans';
const nomConnu = !aCompleter(NOM);
const nom = nomConnu ? NOM : METIER;
// Accueil : métier et villes en tête du titre (ce que les gens tapent dans Google), nom ensuite.
const titreAccueil = `Création de sites internet à ${villesFr()}`;
const titreComplet = titre ? `${titre} — ${nom}` : nomConnu ? `${titreAccueil} — ${NOM}` : titreAccueil;
const absolue = (chemin: string) => new URL(chemin, Astro.site).href;
const canonique = absolue(Astro.url.pathname);
const estAccueil = Astro.url.pathname === LIEN_ACCUEIL;

// Image de partage : présente seulement si `npm run captures` l'a générée.
const imagePartage = existsSync(join(RACINE, 'public', IMAGE_PARTAGE_PERSO)) ? absolue(IMAGE_PARTAGE_PERSO) : undefined;

// Données structurées de l'accueil. Les champs encore « [À COMPLÉTER] » sont omis.
const renseigne = (v: string) => (aCompleter(v) ? undefined : v);
const prix = MOI.gammes.map((g) => g.prix).filter((p): p is number => typeof p === 'number');
const logo = urlLogo('sombre');
const ml = MOI.mentionsLegales;
// Adresse « 2 rue X, 29200 Brest » → rue, code postal, ville (omise si le format ne correspond pas).
const adresse = ml.adresse.match(/^(.+),\s*(\d{5})\s+(.+)$/);
const idEntreprise = absolue('/#entreprise');
const jsonLd = estAccueil
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          // Nom du site affiché par Google au-dessus du résultat.
          '@type': 'WebSite',
          '@id': absolue('/#site'),
          name: nom,
          url: absolue(LIEN_ACCUEIL),
          inLanguage: 'fr-FR',
          publisher: { '@id': idEntreprise },
        },
        {
          '@type': 'ProfessionalService',
          '@id': idEntreprise,
          name: renseigne(NOM) ?? METIER,
          description: MOI.accroche,
          url: absolue(LIEN_ACCUEIL),
          telephone: renseigne(MOI.telephone) && telInternational(MOI.telephone),
          email: renseigne(MOI.email),
          image: imagePartage,
          logo: logo && absolue(logo),
          founder: { '@type': 'Person', name: MOI.nom },
          address: adresse && {
            '@type': 'PostalAddress',
            streetAddress: adresse[1],
            postalCode: adresse[2],
            addressLocality: adresse[3],
            addressCountry: 'FR',
          },
          priceRange: prix.length ? `${prixFr(Math.min(...prix))} – ${prixFr(Math.max(...prix))}` : undefined,
          areaServed: MOI.villes.map((name) => ({ '@type': 'City', name })),
          knowsLanguage: 'fr',
        },
      ],
    }).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="fr" data-site="perso">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#151a1c" />
    <link rel="preload" href="/fonts/libre-franklin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={urlLogo('favicon') ?? '/favicon.svg'} />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    {!PUBLIE && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonique} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    {
      imagePartage && (
        <>
          <meta property="og:image" content={imagePartage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${nom} : sites internet pour commerçants et artisans`} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    <slot name="tete" />
    <!-- Redimensionnement du bandeau : seulement entre deux pages qui en ont un (Modèles, Tarifs,
         Contact). Vers ou depuis l'accueil, la transition est annulée : changement immédiat. -->
    <script is:inline define:vars={{ pagesBandeau: [LIEN_GRILLE, LIEN_TARIFS, LIEN_CONTACT] }}>
      window.addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        const avecBandeau = (url) => {
          try {
            return pagesBandeau.includes(new URL(url, location.href).pathname);
          } catch {
            return false;
          }
        };
        const depart = window.navigation?.activation?.from?.url;
        if (!depart || !avecBandeau(depart) || !avecBandeau(location.href)) e.viewTransition.skipTransition();
      });
    </script>
    <!-- Première page vue de la session : l'accueil peut jouer son animation d'arrivée.
         Ensuite, plus d'animation au retour sur l'accueil (évite le sursaut). -->
    <script is:inline>
      try {
        if (!sessionStorage.getItem('arrivee-vue')) {
          document.documentElement.dataset.premiereVisite = '';
          sessionStorage.setItem('arrivee-vue', '1');
        }
      } catch (e) {}
    </script>
    <!-- Navigation instantanée : quand la souris s'arrête sur un lien interne (ou au début du toucher),
         le navigateur prépare la page en arrière-plan. Pas de JS, pas de traceur ; ignoré par les
         navigateurs qui ne le gèrent pas. -->
    <script type="speculationrules" is:inline>
      { "prerender": [{ "where": { "href_matches": "/*" }, "eagerness": "moderate" }] }
    </script>
  </head>
  <body>
    <a class="lien-evitement" href="#contenu">Aller au contenu</a>
    <EnTete />
    <main id="contenu" tabindex="-1">
      <slot />
    </main>
    <PiedPerso />
  </body>
</html>

