---
// Bandeau en haut des sites de démonstration. Jamais rendu si demo: false.
interface Props {
  demo: boolean;
}
const { demo } = Astro.props;
---

{
  demo && (
    <p class="bandeau-demo" role="note">
      Modèle de démonstration — entreprise fictive
    </p>
  )
}

<style>
  .bandeau-demo {
    padding: 0.4rem 1rem;
    background: #2b2d2f;
    color: #f4f4f4;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 0.8125rem;
    line-height: 1.4;
    text-align: center;
  }
</style>
