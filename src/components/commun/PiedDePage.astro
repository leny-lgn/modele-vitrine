---
// Pied de page commun : coordonnées et liens légaux.
// Premium : version développée sur ardoise (grand nom, numéro en cuivre, horaires résumés),
// pour finir des pages très travaillées autrement que par trois lignes en petit.
import type { Site } from '../../lib/schema';
import { telephoneFr, telHref } from '../../lib/typo-fr';
import { lienSite, type CibleLien } from '../../lib/liens';
import { contientAVerifier } from '../../lib/texte';
import { resumeHoraires } from '../../lib/horaires';
import { ancreGroupe } from '../../lib/services';

interface Props {
  site: Site;
  page?: CibleLien;
  class?: string;
}
const { site, page, class: classe } = Astro.props;
const email = site.email && !contientAVerifier(site.email) ? site.email : undefined;
const premium = site.gamme === 'premium';
const vitrine = site.gamme === 'vitrine';
// Essentiel (accueil) : la page finit sur « Horaires et contact » ; le pied de page ne répète pas
// l'adresse, le téléphone et l'e-mail (nom et liens légaux seulement).
const essentiel = site.gamme === 'essentiel' && page === 'accueil';
const horaires = premium || vitrine ? resumeHoraires(site.horaires) : [];
// Accueil et L'artisan (Premium) finissent déjà par une section « Contact » complète :
// le pied de page n'y répète pas les coordonnées (nom et liens légaux seulement).
const sansRedite = premium && (page === 'accueil' || page === 'artisan');
// Vitrine et Premium : services (liens vers leur page) et communes desservies, en texte (Google).
const plan = premium || vitrine;
const services = site.services.map((g) => ({
  nom: g.groupe,
  lien: premium
    ? g.page && site.pages.includes(g.page) ? lienSite(site, g.page) : undefined
    : site.pages.includes('services') ? `${lienSite(site, 'services')}#${ancreGroupe(g.groupe)}` : undefined,
}));
---

{
  premium ? (
    <footer class:list={['pied-de-page', 'pdp-premium', 'surface-ardoise', classe]}>
      <p class="pdp-grand-nom">{site.nom}</p>
      <div class:list={['pdp-colonnes', { 'pdp-seul': sansRedite }]}>
        {!sansRedite && (
        <>
        <div>
          <a href={telHref(site.telephone)} class="pdp-tel chiffres">
            {telephoneFr(site.telephone)}
          </a>
          <address>
            {site.adresse.rue}
            <br />
            {site.adresse.codePostal}&nbsp;{site.adresse.ville}
            {email && (
              <>
                <br />
                <a href={`mailto:${email}`}>{email}</a>
              </>
            )}
          </address>
        </div>
        <div>
          <p class="pdp-libelle">Horaires</p>
          <ul class="pdp-horaires chiffres">
            {horaires.map((r) => (
              <li>
                {r.jours}&nbsp;: {r.plages}
              </li>
            ))}
            {site.urgences?.actif && site.urgences.plage && <li>Urgences&nbsp;: {site.urgences.plage}</li>}
          </ul>
        </div>
        </>
        )}
        {plan && services.length > 0 && (
          <div>
            <p class="pdp-libelle">Services</p>
            <ul class="pdp-liste">
              {services.map((x) => <li>{x.lien ? <a href={x.lien}>{x.nom}</a> : x.nom}</li>)}
            </ul>
          </div>
        )}
        {plan && (
          <div class="pdp-zone">
            <p class="pdp-libelle">Zone d’intervention</p>
            <p class="pdp-communes">{site.zone.communes.join(', ')}</p>
          </div>
        )}
        <ul class="pdp-legal">
          <li><a href={lienSite(site, 'mentions-legales')}>Mentions légales</a></li>
          <li><a href={lienSite(site, 'confidentialite')}>Confidentialité</a></li>
        </ul>
      </div>
    </footer>
  ) : (

<footer class:list={['pied-de-page', { 'pdp-vitrine': vitrine }, classe]}>
  <div class="pdp-coordonnees">
    <p class="pdp-nom">{site.nom}</p>
    {!essentiel && (
    <address>
      {site.adresse.rue}<br />
      {site.adresse.codePostal}&nbsp;{site.adresse.ville}<br />
      <a href={telHref(site.telephone)} class="chiffres pdp-tel-v">{telephoneFr(site.telephone)}</a>
      {
        email && (
          <>
            <br />
            <a href={`mailto:${email}`}>{email}</a>
          </>
        )
      }
    </address>
    )}
  </div>
  {
    vitrine && horaires.length > 0 && (
      <div class="pdp-horaires-v">
        <p class="pdp-libelle">Horaires</p>
        <ul class="pdp-horaires chiffres">
          {horaires.map((r) => (
            <li>
              {r.jours}&nbsp;: {r.plages}
            </li>
          ))}
          {site.urgences?.actif && site.urgences.plage && <li>Urgences&nbsp;: {site.urgences.plage}</li>}
        </ul>
      </div>
    )
  }
  {
    plan && services.length > 0 && (
      <div>
        <p class="pdp-libelle">Services</p>
        <ul class="pdp-liste">
          {services.map((x) => <li>{x.lien ? <a href={x.lien}>{x.nom}</a> : x.nom}</li>)}
        </ul>
      </div>
    )
  }
  {
    plan && (
      <div class="pdp-zone">
        <p class="pdp-libelle">Zone d’intervention</p>
        <p class="pdp-communes">{site.zone.communes.join(', ')}</p>
      </div>
    )
  }
  <ul class="pdp-legal">
    <li><a href={lienSite(site, 'mentions-legales')}>Mentions légales</a></li>
    <li><a href={lienSite(site, 'confidentialite')}>Confidentialité</a></li>
  </ul>
</footer>
  )
}

<style>
  .pied-de-page {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2rem 1.25rem;
    border-top: 1px solid var(--couleur-trait);
    font-size: 0.9375rem;
  }

  .pdp-nom {
    font-weight: 700;
  }

  address {
    font-style: normal;
  }

  address a,
  .pdp-legal a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* Liens légaux côte à côte, jamais coupés au milieu. */
  .pdp-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    list-style: none;
    padding: 0;
  }

  .pdp-legal a {
    white-space: nowrap;
  }

  /* ——— Vitrine : horaires résumés et numéro mis en avant (plus simple que le Premium) ——— */
  .pdp-vitrine {
    padding-block: var(--espace-4);
    background: var(--couleur-fond-2, transparent);
  }

  .pdp-tel-v {
    color: var(--couleur-lien);
    font-size: var(--taille-1);
    font-weight: 700;
  }

  /* ——— Premium ——— */
  .pdp-premium {
    display: block;
    padding-block: var(--espace-5);
    border-top: 0;
  }

  .pdp-grand-nom {
    font-size: var(--titre-section);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.92;
    text-transform: uppercase;
    hyphens: none;
  }

  .pdp-colonnes {
    display: grid;
    gap: var(--espace-3) var(--espace-4);
    margin-top: var(--espace-4);
  }

  /* Pied de page réduit (accueil, L'artisan) : nom et liens légaux, sans grand vide. */
  .pdp-premium:has(.pdp-seul) {
    padding-block: var(--espace-4);
  }

  .pdp-seul {
    margin-top: var(--espace-2);
  }

  .pdp-tel {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--cuivre-clair);
    font-size: var(--taille-2);
    font-weight: 700;
    text-decoration: none;
  }

  .pdp-premium address {
    margin-top: var(--espace-1);
    color: var(--couleur-texte-secondaire);
  }

  .pdp-libelle {
    font-weight: 700;
  }

  .pdp-liste {
    margin-top: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .pdp-liste a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .pdp-zone {
    max-width: 16rem;
  }

  .pdp-communes {
    margin-top: var(--espace-1);
    color: var(--couleur-texte-secondaire);
  }

  .pdp-horaires {
    margin-top: var(--espace-1);
    padding: 0;
    list-style: none;
    color: var(--couleur-texte-secondaire);
  }

  .pdp-horaires li + li {
    margin-top: 0.2rem;
  }

  @media (min-width: 56rem) {
    /* Colonnes à la largeur de leur contenu (l'e-mail ne se coupe pas), passant à la ligne
       quand la place manque : le pied de page n'occupe que la zone droite de la grille. */
    .pdp-colonnes:not(.pdp-seul) {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .pdp-colonnes:not(.pdp-seul) .pdp-legal {
      flex-basis: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--espace-3);
    }

    /* Version réduite : le nom à gauche, les liens légaux à droite, sur la même ligne. */
    .pdp-premium:has(.pdp-seul) {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--espace-4);
    }

    .pdp-seul {
      margin-top: 0;
      grid-template-columns: max-content minmax(0, 16rem) minmax(0, 1fr);
      align-items: start;
    }

    .pdp-premium .pdp-legal {
      justify-self: end;
    }

    .pdp-premium .pdp-legal a {
      white-space: nowrap;
    }

    .pdp-premium address a {
      overflow-wrap: normal;
    }
  }
</style>
