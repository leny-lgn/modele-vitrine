---
// Trois ou quatre faits courts sous le hero (JSON : arguments). Chacun précédé d'un court
// tronçon cuivre (le trait du brief), pas d'icône. Sur mobile : deux par ligne.
import type { Site } from '../../lib/schema';

interface Props {
  site: Site;
  class?: string;
}
const { site, class: classe } = Astro.props;
---

{
  site.arguments.length > 0 && (
    <ul class:list={['arguments', classe]}>
      {site.arguments.map((a) => (
        <li>{a}</li>
      ))}
    </ul>
  )
}

<style>
  .arguments {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--espace-2) var(--espace-3);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .arguments li {
    padding-top: 0.6rem;
    border-top: 2px solid var(--couleur-accent);
    font-weight: 600;
    line-height: 1.3;
    hyphens: manual;
  }

  @media (min-width: 48rem) {
    .arguments {
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: var(--espace-3) var(--espace-4);
    }
  }
</style>
