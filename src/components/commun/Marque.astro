---
// Marque du site : un raccord en té (le motif du brief : cuivre, trait précis) devant le nom.
// Le té prend la couleur d'accent de la surface (cuivre foncé sur clair, cuivre clair sur ardoise).
// Même dessin que le favicon (public/images/<slug>/favicon.svg).
interface Props {
  nom: string;
  class?: string;
}
const { nom, class: classe } = Astro.props;
---

<span class:list={['marque', classe]}>
  <svg class="marque-te" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <path d="M2 10h24M14 10v16" fill="none" stroke="currentColor" stroke-width="2.5" />
    <rect x="9" y="6" width="10" height="8" rx="2" fill="currentColor" />
    <rect x="1" y="7" width="3" height="6" rx="1" fill="currentColor" />
    <rect x="24" y="7" width="3" height="6" rx="1" fill="currentColor" />
    <rect x="11" y="23" width="6" height="3" rx="1" fill="currentColor" />
  </svg>
  <span class="marque-nom">{nom}</span>
</span>

<style>
  .marque {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  /* Grand écran : le nom tient sur une ligne. Tablette : il peut passer sur deux, comme avant. */
  @media (min-width: 64rem) {
    .marque-nom {
      white-space: nowrap;
    }
  }

  .marque-te {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    color: var(--couleur-accent);
  }
</style>
