---
// Coordonnées : la même annonce encadrée qu'en tête de l'accueil, pour conclure.
// Le mode de rendez-vous (sur place, téléphone, visio) n'est pas répété ici : il figure dans l'accroche
// de l'accueil et dans la première étape, affichée sous la fiche sur la page Contact.
import { MOI, aCompleter } from '../../lib/moi';
import { telephoneFr, telHref, smsHref } from '../../lib/typo-fr';
import Appeler from './Appeler.astro';
import T from './T.astro';
import Pastille from './Pastille.astro';
import { LIEN_VCARD } from '../../lib/liens';

const email = aCompleter(MOI.email) ? undefined : MOI.email;
const tel = aCompleter(MOI.telephone) ? undefined : MOI.telephone;
---

<div class="coord">
  <p class="co-nom"><T texte={MOI.nom} /></p>
  <dl class="points co-faits">
    <div>
      <dt>Téléphone</dt>
      <dd class="valeur mono">{tel ? <a href={telHref(tel)}>{telephoneFr(tel)}</a> : <T texte={MOI.telephone} />}</dd>
    </div>
    <div>
      <dt>E-mail</dt>
      <dd class="valeur">{email ? <a href={`mailto:${email}`}>{email}</a> : <T texte={MOI.email} />}</dd>
    </div>
    <div class="co-zone">
      <dt>Zone</dt>
      <dd class="valeur"><T texte={MOI.zone} /></dd>
    </div>
    <div class="co-long">
      <dt><Pastille />Disponible</dt>
      <dd><T texte={MOI.disponibilites} /></dd>
    </div>
  </dl>
  <div class="co-actions">
    <Appeler />
    {tel && <a class="bouton bouton-trait" href={smsHref(tel)}>Envoyer un SMS</a>}
    {email && <a class="bouton bouton-trait" href={`mailto:${email}`}>Écrire un e-mail</a>}
  </div>
  {
    tel && (
      <p class="co-vcard">
        <a href={LIEN_VCARD} download>Enregistrer mon contact dans votre téléphone</a>
      </p>
    )
  }
</div>

<style>
  .coord {
    margin-top: 1.5rem;
    padding: 1.1rem;
    border: 1px solid var(--filet);
    background: var(--feuille);
    max-width: 44rem;
  }

  .co-nom {
    font-size: clamp(1.5rem, 5.5vw, 2.25rem);
    font-weight: var(--graisse-titres);
    letter-spacing: -0.02em;
    line-height: 1.1;
    hyphens: none;
  }

  .co-faits {
    margin-top: 1rem;
  }

  /* Valeurs longues (disponibilités) : retour à la ligne entre les mots, jamais au milieu d'un mot,
     lignes équilibrées. */
  .co-faits dd {
    hyphens: none;
    text-wrap: balance;
  }

  /* Valeur longue : sous son libellé, sans points de conduite (ils restaient coupés trop courts). */
  .co-faits .co-long {
    display: block;
  }

  .co-faits .co-long dt::after {
    content: none;
  }

  /* Zone sur mobile : « Lannion, Brest, Nantes et alentours » ne tient pas à droite du libellé
     (points de conduite trop courts, valeur coupée en deux lignes) ; elle passe dessous, en entier.
     Sur un écran plus large, elle reste sur la même ligne que « Zone ». */
  @media (max-width: 35.99rem) {
    .co-faits .co-zone {
      display: block;
    }

    .co-faits .co-zone dt::after {
      content: none;
    }

    .co-faits .co-zone dd {
      margin-top: 0.15rem;
      text-align: left;
    }
  }

  .co-faits .co-long dt {
    align-items: center;
  }

  .co-faits .co-long dd {
    margin-top: 0.15rem;
    color: var(--encre-2);
    text-wrap: pretty;
  }

  .co-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .co-vcard {
    margin-top: 0.75rem;
  }

  .co-vcard a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--dore);
    font-weight: var(--graisse-lien);
  }

  @media (min-width: 48rem) {
    .coord {
      padding: 1.75rem;
    }
  }
</style>
