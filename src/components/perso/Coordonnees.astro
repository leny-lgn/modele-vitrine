---
// Coordonnées : la même annonce encadrée qu'en tête de l'accueil, pour conclure.
// Le mode de rendez-vous (sur place, téléphone, visio) n'est pas répété ici : il figure dans l'accroche
// de l'accueil et dans la première étape, affichée sous la fiche sur la page Contact.
import { MOI, aCompleter } from '../../lib/moi';
import { telephoneFr, telHref } from '../../lib/typo-fr';
import Appeler from './Appeler.astro';
import T from './T.astro';

const email = aCompleter(MOI.email) ? undefined : MOI.email;
const tel = aCompleter(MOI.telephone) ? undefined : MOI.telephone;
---

<div class="coord">
  <p class="co-nom"><T texte={MOI.nom} /></p>
  <dl class="points co-faits">
    <div>
      <dt>Téléphone</dt>
      <dd class="valeur mono">{tel ? <a href={telHref(tel)}>{telephoneFr(tel)}</a> : <T texte={MOI.telephone} />}</dd>
    </div>
    <div>
      <dt>E-mail</dt>
      <dd class="valeur">{email ? <a href={`mailto:${email}`}>{email}</a> : <T texte={MOI.email} />}</dd>
    </div>
    <div>
      <dt>Zone</dt>
      <dd class="valeur"><T texte={MOI.zone} /></dd>
    </div>
    <div class="co-long">
      <dt><span class="co-pastille" aria-hidden="true"></span>Disponible</dt>
      <dd><T texte={MOI.disponibilites} /></dd>
    </div>
  </dl>
  <div class="co-actions">
    <Appeler />
    {email && <a class="bouton bouton-trait" href={`mailto:${email}`}>Écrire un e-mail</a>}
  </div>
</div>

<style>
  .coord {
    margin-top: 1.5rem;
    padding: 1.1rem;
    border: 1px solid var(--filet);
    background: var(--feuille);
    max-width: 44rem;
  }

  .co-nom {
    font-size: clamp(1.5rem, 5.5vw, 2.25rem);
    font-weight: var(--graisse-titres);
    letter-spacing: -0.02em;
    line-height: 1.1;
    hyphens: none;
  }

  .co-faits {
    margin-top: 1rem;
  }

  /* Valeurs longues (disponibilités) : retour à la ligne entre les mots, jamais au milieu d'un mot,
     lignes équilibrées. */
  .co-faits dd {
    hyphens: none;
    text-wrap: balance;
  }

  /* Valeur longue : sous son libellé, sans points de conduite (ils restaient coupés trop courts). */
  .co-faits .co-long {
    display: block;
  }

  .co-faits .co-long dt::after {
    content: none;
  }

  /* Pastille verte fixe (pas d'état « ouvert maintenant » : la disponibilité est 7 j/7).
     Vert lisible sur le panneau sombre (contraste > 3:1 pour un élément graphique). */
  .co-pastille {
    position: relative;
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-inline: 0.15rem 0.25rem; /* place pour le halo, sans toucher le mot */
    border-radius: 50%;
    background: #4fbf7f;
  }

  /* Halo de « voyant allumé » : un anneau part de la pastille, grandit (× 2,2) et s'efface.
     2,4 s par battement, ease-out : départ net, fin très douce, rythme calme qui ne tire pas l'œil.
     Seuls transform et opacity bougent (aucun recalcul de mise en page).
     Exception voulue par l'utilisateur à la règle « une seule animation » du site perso. */
  .co-pastille::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #4fbf7f;
    animation: co-halo 2.4s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  @keyframes co-halo {
    from {
      opacity: 0.55;
      transform: scale(1);
    }

    to {
      opacity: 0;
      transform: scale(2.2);
    }
  }

  /* « Réduire les animations » : la pastille reste allumée, sans halo. */
  @media (prefers-reduced-motion: reduce) {
    .co-pastille::after {
      animation: none;
      opacity: 0;
    }
  }

  .co-faits .co-long dt {
    align-items: center;
  }

  .co-faits .co-long dd {
    margin-top: 0.15rem;
    color: var(--encre-2);
    text-wrap: pretty;
  }

  .co-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 48rem) {
    .coord {
      padding: 1.75rem;
    }
  }
</style>
