---
// « Qui je suis » : photo facultative (public/images/accueil/<photo>), l'origine du nom
// (facultative) et quelques phrases. Sans photo, le texte occupe seul la section.
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { MOI } from '../../lib/moi';
import { RACINE, cheminRelatif, urlImage } from '../../lib/images.mjs';
import T from './T.astro';

const photo = MOI.photo && existsSync(join(RACINE, cheminRelatif('accueil', MOI.photo))) ? MOI.photo : undefined;
const histoire = MOI.histoireNom;
---

<div class:list={['qui', { 'avec-photo': photo }]}>
  {
    photo && (
      <img
        class="qui-photo"
        src={urlImage('accueil', photo)}
        width="600"
        height="750"
        alt={`Portrait de ${MOI.nom}`}
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="qui-texte">
    {
      histoire && (
        <div class="qui-histoire">
          <h3 class="qui-histoire-titre">
            <T texte={histoire.titre} />
          </h3>
          <p>
            <T texte={histoire.texte} />
          </p>
        </div>
      )
    }
    <div class="qui-presentation">
      {
        MOI.presentation.map((p) => (
          <p>
            <T texte={p} />
          </p>
        ))
      }
    </div>
  </div>
</div>

<style>
  .qui {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .qui-texte {
    max-width: 40rem;
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .qui-presentation p + p {
    margin-top: 0.9rem;
  }

  .qui-histoire-titre {
    margin-bottom: 0.4rem;
    color: var(--dore);
    font-size: 1.1875rem;
    font-weight: var(--graisse-titres);
  }

  /* L'histoire du nom, séparée de la présentation par un filet. */
  .qui-histoire {
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--filet);
  }

  .qui-photo {
    width: 100%;
    max-width: 16rem;
    height: auto;
    border: 1px solid var(--filet);
  }

  /* Grand écran sans photo : l'histoire du nom à gauche, la présentation à droite. */
  @media (min-width: 64rem) {
    .qui:not(.avec-photo) .qui-texte:has(.qui-histoire) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3rem;
      max-width: none;
    }

    .qui:not(.avec-photo) .qui-histoire {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: 0;
    }

    .qui:not(.avec-photo) .qui-presentation {
      padding-left: 3rem;
      border-left: 1px solid var(--filet);
    }
  }

  @media (min-width: 48rem) {
    .avec-photo {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
