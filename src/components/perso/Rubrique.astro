---
// Une rubrique d'annuaire par secteur : les trois modèles côte à côte, en trois cartes de même
// largeur, chacune avec la capture ordinateur de son modèle. Seul le cadre s'affirme avec la gamme
// (filet seul, encadré, cadre épais) : l'annonce « grandit » sans que l'Essentiel paraisse orphelin.
// Pas de prix ni de numéro fictif ici : la page sert à voir les modèles, Tarifs à comparer les prix.
// Générée depuis src/sites/ : chaque nouveau secteur apparaît seul.
import type { Gamme, Site } from '../../lib/schema';
import { infosSecteur, LIBELLES_GAMMES } from '../../lib/secteurs';
import { lienSite } from '../../lib/liens';
import { gamme } from '../../lib/moi';
import Capture from './Capture.astro';
import T from './T.astro';

interface Props {
  secteur: string;
  sites: Partial<Record<Gamme, Site>>;
  /** Niveau du titre de la rubrique (2 sur /modeles/, 3 sur l'accueil). */
  niveau?: 2 | 3;
}
const { secteur, sites, niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3';
const TitreAnnonce = `h${niveau + 1}` as 'h3' | 'h4';
const libelle = infosSecteur(secteur).libelle;
const idRubrique = `rubrique-${secteur}`;

const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
function nbPages(site: Site): string {
  const chantiers = site.gamme === 'premium' ? site.realisations.filter((r) => r.slug).length : 0;
  return chantiers
    ? `${pluriel(site.pages.length, 'page')} + ${pluriel(chantiers, 'page')} de chantier`
    : pluriel(site.pages.length, 'page');
}
---

<section class="rubrique-metier" aria-labelledby={idRubrique}>
  <Titre id={idRubrique} class="rubrique">{libelle}</Titre>
  <div class="annonces">
    {
      (['essentiel', 'vitrine', 'premium'] as const).map((g) => {
        const site = sites[g];
        if (!site) return null;
        return (
          <article class:list={['annonce', `annonce-${g}`]}>
            <Capture
              slug={site.slug}
              vue="bureau"
              alt={`Page d’accueil du modèle ${libelle} ${LIBELLES_GAMMES[g]}, sur ordinateur`}
              sizes="(min-width: 56rem) 30vw, 92vw"
            />
            <div class="an-texte">
              <TitreAnnonce class="an-gamme">{LIBELLES_GAMMES[g]}</TitreAnnonce>
              <p class="an-pourqui">
                <T texte={gamme(g).pourQui} />
              </p>
              <p class="an-details">
                {site.nom} · {nbPages(site)}
              </p>
              <a class="an-lien" href={lienSite(site)}>
                Ouvrir le modèle {LIBELLES_GAMMES[g]}
                <span class="visuellement-cache"> ({libelle}, entreprise fictive)</span>
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .rubrique-metier + .rubrique-metier {
    margin-top: 3rem;
  }

  .annonces {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .annonce {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0.9rem;
    border: 1px solid var(--filet-doux);
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  /* L'annonce s'affirme avec la gamme : filet discret, encadré, cadre épais. */
  .annonce-vitrine {
    border-color: var(--filet);
    background: var(--feuille);
  }

  .annonce-premium {
    border: 2px solid var(--filet);
    background: var(--feuille);
  }

  .annonce :global(.capture) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--filet-doux);
  }

  /* Toute l'annonce est cliquable ; le lien reste le seul élément interactif. */
  .an-lien::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Survol de l'annonce : léger éclaircissement, cadre doré */
  .annonce:has(.an-lien:hover) {
    background: rgb(239 232 216 / 0.06);
    border-color: var(--dore);
  }

  .an-texte {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin-top: 0.9rem;
  }

  .an-gamme {
    font-size: 1.25rem;
    font-weight: var(--graisse-titres);
  }

  .an-pourqui {
    margin-top: 0.2rem;
    hyphens: manual;
  }

  .an-details {
    margin-top: 0.35rem;
    color: var(--encre-2);
    font-size: 0.9375rem;
  }

  /* Liens alignés en bas des trois cartes. */
  .an-lien {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-weight: var(--graisse-lien);
    color: var(--dore);
  }

  @media (min-width: 56rem) {
    .annonces {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }
</style>
