---
// « Comment ça se passe » : les étapes dans l'ordre (la numérotation porte l'information).
import { MOI } from '../../lib/moi';
import T from './T.astro';

interface Props {
  niveau?: 3 | 4;
}
const Titre = `h${Astro.props.niveau ?? 3}` as 'h3' | 'h4';
---

<ol class="etapes" style={`--n: ${MOI.etapes.length}`}>
  {
    MOI.etapes.map((e, i) => (
      <li>
        <span class="et-num mono" aria-hidden="true">
          {i + 1}
        </span>
        <div>
          <Titre class="et-titre">
            <T texte={e.titre} />
          </Titre>
          <p>
            <T texte={e.texte} />
          </p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .etapes {
    display: grid;
    margin-top: 2rem;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.75rem;
    padding-block: 1rem;
    border-top: 1px solid var(--encre);
  }

  .et-num {
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.1;
    color: var(--dore);
  }

  .et-titre {
    font-size: 1.125rem;
    font-weight: 800;
  }

  p {
    margin-top: 0.2rem;
  }

  @media (min-width: 60rem) {
    .etapes {
      grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr));
      border-top: 3px solid var(--encre);
    }

    li {
      grid-template-columns: 1fr;
      align-content: start;
      padding: 1rem 1rem 0 1rem;
      border-top: 0;
      border-left: 1px solid var(--encre);
    }

    li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
