---
// « Votre métier, votre taille d'annonce » : une page d'annuaire où l'annonce du modèle
// grandit selon la gamme choisie (une ligne, un encadré, une pleine annonce).
// À côté de l'annonce : ce que la gamme ajoute à la précédente et les gammes au-dessus
// (un clic les sélectionne). Seulement la différence : le détail complet reste dans Tarifs.
// Sans JS : le choix de gamme marche (CSS :has, labels) ; le choix du métier est masqué.
// Générée depuis src/sites/ et moi.json : chaque nouveau secteur apparaît seul.
import type { Gamme, Site } from '../../lib/schema';
import { infosSecteur, LIBELLES_GAMMES } from '../../lib/secteurs';
import { lienSite } from '../../lib/liens';
import { MOI, gamme, prixFr, villesFr } from '../../lib/moi';
import { telephoneFr } from '../../lib/typo-fr';
import { sitesParSecteur } from '../../lib/sites';
import Capture from './Capture.astro';
import T from './T.astro';

const GAMMES_ORDRE = ['essentiel', 'vitrine', 'premium'] as const;
const secteurs = [...sitesParSecteur().entries()];
const [secteurDefaut] = secteurs[0];
const avecModele = new Set(secteurs.map(([s]) => infosSecteur(s).libelle.toLowerCase()));
const sansModele = MOI.metiers.filter((m) => !avecModele.has(m.toLowerCase()));

// Ce qu'une gamme ajoute aux précédentes : ses points « inclus », sans « Tout l'Essentiel… »
// ni ce qui figure déjà, mot pour mot, dans une gamme inférieure.
function ajouts(id: Gamme): string[] {
  const i = GAMMES_ORDRE.indexOf(id);
  const dessous = new Set(GAMMES_ORDRE.slice(0, i).flatMap((g) => gamme(g).inclus));
  return gamme(id).inclus.filter((x) => !/^Tout /.test(x) && !dessous.has(x));
}
const precedente = (id: Gamme) => GAMMES_ORDRE[GAMMES_ORDRE.indexOf(id) - 1] as Gamme | undefined;
const audessus = (id: Gamme) => GAMMES_ORDRE.slice(GAMMES_ORDRE.indexOf(id) + 1) as Gamme[];
// Gamme la plus haute : on propose les autres, de la plus proche à la plus simple.
const autres = (id: Gamme) =>
  audessus(id).length > 0 ? audessus(id) : (GAMMES_ORDRE.filter((g) => g !== id).reverse() as Gamme[]);
const titreAutres = (id: Gamme) =>
  audessus(id).length === 0 ? 'Les autres gammes' : audessus(id).length > 1 ? 'Les gammes au-dessus' : 'La gamme au-dessus';

const pluriel = (n: number, mot: string) => `${n} ${mot}${n > 1 ? 's' : ''}`;
function nbPages(site: Site): string {
  const chantiers = site.gamme === 'premium' ? site.realisations.filter((r) => r.slug).length : 0;
  return chantiers
    ? `${pluriel(site.pages.length, 'page')} + ${pluriel(chantiers, 'page')} de chantier`
    : pluriel(site.pages.length, 'page');
}
---

<div class="trouver" data-trouver>
  <div class="tr-commandes">
    <div class="tr-metier" data-zone-metier hidden>
      <label for="tr-metier">Votre métier</label>
      <select id="tr-metier" data-metier>
        <optgroup label="Avec un modèle">
          {
            secteurs.map(([s]) => (
              <option value={s} data-libelle={infosSecteur(s).libelle}>
                {infosSecteur(s).libelle}
              </option>
            ))
          }
        </optgroup>
        {
          sansModele.length > 0 && (
            <optgroup label="Pas encore de modèle">
              {sansModele.map((m) => (
                <option value="" data-libelle={m}>
                  {m}
                </option>
              ))}
            </optgroup>
          )
        }
      </select>
    </div>

    <fieldset class="tr-gammes">
      <legend>Taille du site</legend>
      <div class="tr-choix">
        {
          GAMMES_ORDRE.map((g) => (
            <label class="tr-gamme">
              <input
                class="visuellement-cache"
                type="radio"
                name="tr-gamme"
                id={`tr-g-${g}`}
                value={g}
                checked={g === 'vitrine'}
                aria-labelledby={`tr-gn-${g} tr-gp-${g}`}
              />
              <span class="tr-g-nom" id={`tr-gn-${g}`}>{LIBELLES_GAMMES[g]}</span>
              <span class="tr-g-prix mono" id={`tr-gp-${g}`}>
                <T texte={prixFr(gamme(g).prix)} />
              </span>
            </label>
          ))
        }
      </div>
    </fieldset>
  </div>

  <div class="tr-page">
    <p class="rubrique tr-rubrique">
      <span data-rubrique>{infosSecteur(secteurDefaut).libelle}</span>
      <span class="tr-lieu">{villesFr()}</span>
    </p>
    <p class="tr-note" data-note aria-live="polite" hidden></p>

    <div class="tr-feuille">
      {
        secteurs.map(([secteur, sites], i) => (
          <div class="tr-annonces" data-secteur={secteur} hidden={i > 0}>
            {GAMMES_ORDRE.map((g) => {
              const site: Site | undefined = sites[g as Gamme];
              if (!site) return null;
              const libelle = infosSecteur(secteur).libelle;
              return (
                <article class:list={['tr-annonce', `tr-${g}`]} data-gamme={g}>
                  <div class="tr-carte">
                    <Capture
                      slug={site.slug}
                      vue="bureau"
                      class="tr-capture"
                      alt={`Page d’accueil du modèle ${libelle} ${LIBELLES_GAMMES[g]}, sur ordinateur`}
                      sizes={
                        g === 'premium'
                          ? '(min-width: 64rem) 640px, 90vw'
                          : g === 'vitrine'
                            ? '(min-width: 48rem) 45vw, 90vw'
                            : '(min-width: 48rem) 24vw, 50vw'
                      }
                    />
                    <div class="tr-texte">
                      <p class="tr-ligne">
                        <strong class="tr-nom">{site.nom}</strong>
                        <span class="tr-suite">
                          <span class="conduite" aria-hidden="true" />
                          <span class="tr-tel">
                            {telephoneFr(site.telephone)} <span class="tr-fictif">(n°&nbsp;fictif)</span>
                          </span>
                        </span>
                      </p>
                      {g !== 'essentiel' && <p class="tr-accroche">{site.accroche}</p>}
                      <p class="tr-details">
                        {LIBELLES_GAMMES[g]} · {nbPages(site)} · <span class="mono"><T texte={prixFr(gamme(g).prix)} /></span>
                      </p>
                      <a class="tr-lien" href={lienSite(site)}>
                        Ouvrir le modèle {LIBELLES_GAMMES[g]}
                        <span class="visuellement-cache"> ({libelle}, entreprise fictive)</span>
                      </a>
                    </div>
                  </div>

                  <div class="tr-plus">
                    {g !== 'essentiel' && (
                      <div class="tr-plus-bloc">
                        <p class="tr-fiche-pourqui">
                          <T texte={`${gamme(g).pourQui}.`} />
                        </p>
                        <dl class="points tr-fiche-faits">
                          <div>
                            <dt>Pages</dt>
                            <dd class="valeur">
                              <T texte={gamme(g).pages} />
                            </dd>
                          </div>
                          <div>
                            <dt>Délai</dt>
                            <dd class="valeur">
                              <T texte={gamme(g).delai} />
                            </dd>
                          </div>
                        </dl>
                        <p class="tr-fiche-note">
                          <T texte={MOI.noteDelais} />
                        </p>
                      </div>
                    )}
                    {precedente(g) && ajouts(g).length > 0 && (
                      <div class="tr-plus-bloc">
                        <p class="tr-plus-titre">
                          <T texte={`En plus de la gamme ${LIBELLES_GAMMES[precedente(g)!]} :`} />
                        </p>
                        <ul class="tr-plus-liste">
                          {ajouts(g).map((x) => (
                            <li>
                              <T texte={x} />
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {autres(g).length > 0 && (
                      <div class="tr-plus-bloc">
                        <p class="tr-plus-titre">{titreAutres(g)}</p>
                        <ul class="tr-options">
                          {autres(g).map((h) => (
                            <li>
                              <label class="tr-option" for={`tr-g-${h}`}>
                                <span class="tr-o-tete">
                                  <span class="tr-o-nom">{LIBELLES_GAMMES[h]}</span>
                                  <span class="conduite" aria-hidden="true" />
                                  <span class="mono">
                                    <T texte={prixFr(gamme(h).prix)} />
                                  </span>
                                </span>
                                <span class="tr-o-detail">
                                  <T texte={audessus(g).includes(h) ? ajouts(h).join(' · ') : gamme(h).pourQui} />
                                </span>
                              </label>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  // Choix du métier : met à jour la rubrique et montre le modèle du métier, ou le plus proche.
  for (const bloc of document.querySelectorAll<HTMLElement>('[data-trouver]')) {
    const zone = bloc.querySelector<HTMLElement>('[data-zone-metier]');
    const choix = bloc.querySelector<HTMLSelectElement>('[data-metier]');
    const rubrique = bloc.querySelector<HTMLElement>('[data-rubrique]');
    const note = bloc.querySelector<HTMLElement>('[data-note]');
    const groupes = [...bloc.querySelectorAll<HTMLElement>('[data-secteur]')];
    if (!zone || !choix || !rubrique || !note || groupes.length === 0) continue;
    zone.hidden = false;
    const exemple = rubrique.textContent ?? '';

    choix.addEventListener('change', () => {
      const option = choix.selectedOptions[0];
      const libelle = option?.dataset.libelle ?? exemple;
      const secteur = choix.value || groupes[0].dataset.secteur;
      rubrique.textContent = libelle;
      for (const g of groupes) g.hidden = g.dataset.secteur !== secteur;
      if (choix.value) {
        note.hidden = true;
        note.textContent = '';
      } else {
        note.hidden = false;
        // Typographie française : insécables dans les guillemets et avant « : ».
        note.textContent = `Pas encore de modèle « ${libelle} » : voici le modèle ${exemple}. Votre site suit la même structure, avec vos informations, vos horaires et vos photos.`;
      }
    });
  }
</script>

<style>
  .trouver {
    margin-top: 2rem;
  }

  /* Commandes : métier puis taille */
  .tr-commandes {
    display: grid;
    gap: 1.25rem;
    align-items: end;
  }

  .tr-metier {
    display: grid;
    gap: 0.35rem;
  }

  .tr-metier[hidden] {
    display: none;
  }

  .tr-metier label,
  .tr-gammes legend {
    font-weight: 800;
  }

  .tr-metier select {
    min-height: 3rem;
    padding: 0.5rem 2.5rem 0.5rem 0.75rem;
    border: 2px solid var(--encre);
    border-radius: 0;
    background:
      linear-gradient(45deg, transparent 50%, var(--encre) 50%) right 1.1rem center / 0.4rem 0.4rem no-repeat,
      linear-gradient(-45deg, transparent 50%, var(--encre) 50%) right 0.7rem center / 0.4rem 0.4rem no-repeat,
      var(--feuille);
    color: var(--encre);
    font: inherit;
    font-weight: 600;
    appearance: none;
  }

  .tr-gammes {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .tr-gammes legend {
    margin-bottom: 0.35rem;
    padding: 0;
  }

  .tr-choix {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 2px solid var(--encre);
  }

  .tr-gamme {
    display: grid;
    align-content: center;
    gap: 0.1rem;
    min-height: 3.5rem;
    padding: 0.45rem 0.6rem;
    cursor: pointer;
    background: var(--feuille);
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .tr-gamme + .tr-gamme {
    border-left: 1px solid var(--encre);
  }

  .tr-gamme:active {
    transform: scale(0.97);
  }

  .tr-g-nom {
    font-weight: 800;
    line-height: 1.2;
  }

  .tr-g-prix {
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .tr-gamme:has(input:checked) {
    background: var(--dore);
    color: var(--sur-dore);
  }

  .tr-gamme:has(input:checked) :global(.a-completer) {
    color: #3d3000;
  }

  .tr-gamme:has(input:focus-visible) {
    outline: 3px solid var(--dore);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .tr-gamme:not(:has(input:checked)):hover {
      background: rgb(201 164 76 / 0.14);
    }
  }

  /* La page d'annuaire */
  .tr-page {
    margin-top: 1.5rem;
    border: 1px solid var(--encre);
    background: var(--feuille);
  }

  .tr-rubrique {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .tr-lieu {
    font-weight: 500;
    font-size: 1rem;
    text-transform: none;
  }

  .tr-note {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--encre);
    max-width: none;
  }

  .tr-note[hidden] {
    display: none;
  }

  /* Une seule annonce affichée : la feuille prend sa hauteur. Fond uni, sans lignes d'annuaire. */
  .tr-annonces {
    display: grid;
    padding: 1rem;
  }

  .tr-annonces[hidden] {
    display: none;
  }

  .tr-annonce {
    display: none;
  }

  /* Changement de gamme : l'annonce choisie entre en 220 ms, ease-out marqué (légère mise au
     point : fondu, 98 % → 100 %, flou de 2 px). L'ancienne disparaît aussitôt : rien à regarder. */
  .trouver:has(input[value='essentiel']:checked) .tr-essentiel,
  .trouver:has(input[value='vitrine']:checked) .tr-vitrine,
  .trouver:has(input[value='premium']:checked) .tr-premium {
    display: grid;
    gap: 1rem;
    align-items: start;
    animation: tr-entree 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  @keyframes tr-entree {
    from {
      opacity: 0;
      transform: scale(0.98);
      filter: blur(2px);
    }
  }

  .tr-carte {
    position: relative;
    background: var(--feuille);
    transform-origin: top left;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  /* Survol de l'annonce : léger éclaircissement, cadre doré */
  .tr-carte:has(.tr-lien:hover) {
    background: rgb(239 232 216 / 0.06);
    border-color: var(--dore);
  }

  .tr-lien::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Les captures ordinateur sont lisibles : la taille croît avec la gamme
     (Essentiel : vignette ; Vitrine : largeur de l'annonce ; Premium : plus large encore). */
  .tr-carte :global(.capture) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--filet-doux);
  }

  /* Essentiel : une ligne parmi les autres, un peu plus appuyée, vignette à droite */
  .tr-essentiel .tr-carte {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 50%;
    gap: 1rem;
    align-items: center;
    padding: 0.75rem 0.5rem;
    border-block: 2px solid var(--encre);
  }

  .tr-essentiel :global(.tr-capture) {
    grid-column: 2;
    grid-row: 1;
  }

  .tr-essentiel .tr-texte {
    grid-column: 1;
    grid-row: 1;
  }

  /* Vitrine : encadré au filet fin ; Premium : cadre épais. Capture en tête, texte dessous. */
  .tr-vitrine .tr-carte,
  .tr-premium .tr-carte {
    padding: 0.9rem;
    border: 1px solid var(--encre);
  }

  .tr-premium .tr-carte {
    border-width: 3px;
  }

  .tr-vitrine .tr-texte,
  .tr-premium .tr-texte {
    margin-top: 0.9rem;
  }

  /* À côté de l'annonce : ce que la gamme ajoute, puis les gammes au-dessus.
     Cadre en tirets : un renvoi d'annuaire, pas une annonce. */
  .tr-plus {
    padding: 1rem;
    border: 1px dashed var(--encre-2);
    background: var(--feuille);
  }

  .tr-plus-bloc + .tr-plus-bloc {
    margin-top: 1.25rem;
  }

  .tr-plus-titre {
    font-weight: 800;
  }

  /* Vitrine et Premium (annonces hautes) : en tête du renvoi, à qui sert la gamme,
     puis pages et délai, en lignes à points de conduite. Tout vient de moi.json. */
  .tr-fiche-pourqui {
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .tr-fiche-faits {
    margin-top: 0.5rem;
  }

  .tr-fiche-note {
    margin-top: 0.35rem;
    color: var(--encre-2);
    font-size: 0.875rem;
  }

  .tr-plus-liste {
    margin-top: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .tr-plus-liste li {
    position: relative;
    padding-block: 0.15rem;
    padding-left: 1.1rem;
  }

  .tr-plus-liste li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.55rem;
    border-top: 2px solid var(--dore);
  }

  .tr-options {
    margin-top: 0.25rem;
    padding: 0;
    list-style: none;
  }

  .tr-options li + li {
    border-top: 1px solid var(--filet-doux);
  }

  /* Une gamme au-dessus : un clic la sélectionne dans les onglets (label du bouton radio). */
  .tr-option {
    display: grid;
    gap: 0.15rem;
    min-height: 2.75rem;
    padding-block: 0.6rem;
    cursor: pointer;
  }

  .tr-o-tete {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-weight: 700;
  }

  .tr-o-nom {
    color: var(--dore);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Pas de césure dans les renvois : des points courts, coupés entre les mots seulement. */
  .tr-plus {
    hyphens: none;
  }

  .tr-o-detail {
    color: var(--encre-2);
    font-size: 0.9375rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .tr-o-nom {
      transition: color 150ms ease;
    }

    .tr-option:hover .tr-o-nom {
      color: var(--dore-vif);
    }
  }

  /* Points de conduite : « Nom ······ numéro », « Gamme ······ prix » */
  .conduite {
    flex: 1 1 1.5rem;
    min-width: 1.5rem;
    border-bottom: 2px dotted var(--encre);
    transform: translateY(-0.3em);
  }

  .tr-ligne {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }

  .tr-nom {
    font-weight: 800;
    hyphens: none;
  }

  .tr-suite {
    display: flex;
    flex: 1 1 auto;
    align-items: baseline;
    gap: 0.4rem;
  }

  /* Le numéro et « (n° fictif) » sont insécables chacun : sur une colonne étroite (Essentiel
     sur mobile), la mention passe à la ligne au lieu de déborder sur la capture. */
  .tr-tel {
    min-width: 0;
    font-size: 0.9375rem;
  }

  .tr-fictif,
  .tr-details {
    color: var(--encre-2);
  }

  .tr-accroche {
    margin-top: 0.35rem;
    hyphens: manual;
  }

  .tr-details {
    margin-top: 0.35rem;
    font-size: 0.9375rem;
  }

  .tr-lien {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
    color: var(--dore);
  }

  @media (min-width: 48rem) {
    .tr-commandes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: 1.5rem;
    }

    .tr-annonces {
      padding: 1.25rem;
    }

    /* L'annonce à gauche, le renvoi à droite, à la même hauteur (pas de lignes grises à côté) ;
       le Premium prend un peu plus de place. */
    .trouver:has(input[value='essentiel']:checked) .tr-essentiel,
    .trouver:has(input[value='vitrine']:checked) .tr-vitrine {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem;
      align-items: stretch;
    }

    .trouver:has(input[value='premium']:checked) .tr-premium {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: stretch;
    }

    .tr-plus {
      padding: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trouver:has(input:checked) .tr-annonce {
      animation: none;
    }

    .tr-gamme:active {
      transform: none;
    }
  }
</style>
