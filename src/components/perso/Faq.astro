---
// Questions fréquentes : liste de questions dépliables (<details>), fonctionne sans JS.
// Seules les questions s'affichent d'emblée ; la réponse s'ouvre au clic ou au clavier.
// Avec JS : la réponse se déplie en douceur (hauteur animée, tous navigateurs). Sans JS : ouverture nette.
// À côté (grand écran) : « Une autre question ? » avec le bouton Appeler et l'e-mail.
import { MOI, aCompleter } from '../../lib/moi';
import Appeler from './Appeler.astro';
import { typoFr } from '../../lib/typo-fr';
import T from './T.astro';

const email = aCompleter(MOI.email) ? undefined : MOI.email;
---

<div class="faq-zone">
<div class="faq">
  {
    MOI.faq.map((f) => (
      <details class="faq-item">
        <summary>
          <h3 class="faq-q">
            <T texte={f.q} />
          </h3>
          <span class="faq-signe" aria-hidden="true" />
        </summary>
        <div class="faq-r">
          <p>
            <T texte={f.r} />
          </p>
        </div>
      </details>
    ))
  }
</div>
<aside class="faq-autre" aria-label="Poser une autre question">
  <p class="fa-titre">{typoFr('Une autre question ?')}</p>
  <p><T texte={typoFr(`Appelez-moi ou écrivez-moi. Disponible ${MOI.disponibilites}.`)} /></p>
  <Appeler />
  {email && <p class="fa-email">Ou par e-mail&nbsp;: <a href={`mailto:${email}`}>{email}</a></p>}
</aside>
</div>

<style>
  .faq-zone {
    display: grid;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .faq-autre {
    align-self: start;
    max-width: 26rem;
    padding: 1.25rem;
    border: 1px solid var(--filet);
  }

  .fa-titre {
    font-size: 1.25rem;
    font-weight: var(--graisse-titres);
  }

  .faq-autre > p + p {
    margin-top: 0.35rem;
  }

  .faq-autre :global(.appeler) {
    margin-top: 1rem;
  }

  .fa-email {
    margin-top: 0.75rem;
    color: var(--encre-2);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 64rem) {
    .faq-zone {
      grid-template-columns: minmax(0, 52rem) minmax(16rem, 1fr);
      gap: 3rem;
    }
  }

  .faq {
    max-width: 52rem;
    border-bottom: 1px solid var(--filet);
  }

  .faq-item {
    border-top: 1px solid var(--filet);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.75rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--dore);
    outline-offset: 3px;
  }

  .faq-q {
    font-size: 1.125rem;
    font-weight: var(--graisse-forte);
    line-height: 1.3;
  }

  /* Signe + dessiné en CSS, qui devient − à l'ouverture (la barre verticale se couche). */
  .faq-signe {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--dore);
    border-radius: 50%;
  }

  .faq-signe::before,
  .faq-signe::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.8rem;
    height: 2px;
    margin: -1px 0 0 -0.4rem;
    background: var(--dore);
  }

  .faq-signe::after {
    transform: rotate(90deg);
  }

  .faq-item[open]:not(.se-ferme) .faq-signe {
    background: var(--dore);
  }

  .faq-item[open]:not(.se-ferme) .faq-signe::before,
  .faq-item[open]:not(.se-ferme) .faq-signe::after {
    background: var(--sur-dore);
  }

  .faq-item[open]:not(.se-ferme) .faq-signe::after {
    transform: rotate(0deg);
  }

  .faq-r {
    overflow: hidden;
  }

  .faq-r p {
    max-width: 40rem;
    padding-bottom: 1.1rem;
    padding-right: 3rem;
  }

  /* Le signe suit le geste : la barre du + se couche (≈ même durée que le dépliement). */
  @media (prefers-reduced-motion: no-preference) {
    .faq-signe,
    .faq-signe::before,
    .faq-signe::after {
      transition:
        transform 300ms cubic-bezier(0.32, 0.72, 0, 1),
        background-color 200ms ease;
    }
  }
</style>

<script>
  // Dépliement des réponses. Ouverture : 340 ms, courbe « tiroir » (départ franc, arrivée très douce),
  // le texte apparaît en fondu et remonte de 6 px. Fermeture plus brève (260 ms) : on range.
  // Un clic pendant le mouvement repart de la hauteur actuelle, sans à-coup.
  // « Réduire les animations » : ouverture et fermeture immédiates.
  const COURBE = 'cubic-bezier(0.32, 0.72, 0, 1)';
  const calme = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const item of document.querySelectorAll<HTMLDetailsElement>('.faq-item')) {
    const question = item.querySelector('summary');
    const reponse = item.querySelector<HTMLElement>('.faq-r');
    if (!question || !reponse) continue;
    let animation: Animation | null = null;
    let texte: Animation | null = null;

    question.addEventListener('click', (e) => {
      if (calme.matches) return;
      e.preventDefault();
      // Fermée, la réponse garde sa taille dans Chrome (contenu caché, pas retiré) : on part de 0.
      const depart = item.open ? reponse.getBoundingClientRect().height : 0;
      animation?.cancel();
      texte?.cancel();
      const ouvrir = !item.open || item.classList.contains('se-ferme');

      if (ouvrir) {
        item.classList.remove('se-ferme');
        item.open = true;
        const fin = reponse.scrollHeight;
        animation = reponse.animate({ height: [`${depart}px`, `${fin}px`] }, { duration: 340, easing: COURBE });
        texte = reponse.animate(
          { opacity: [depart > 0 ? 1 : 0, 1], transform: [depart > 0 ? 'none' : 'translateY(-6px)', 'none'] },
          { duration: 300, delay: 40, easing: COURBE, fill: 'backwards' },
        );
        animation.onfinish = () => {
          animation = null;
        };
      } else {
        item.classList.add('se-ferme');
        // fill: 'forwards' : la réponse reste à 0 jusqu'à la fermeture du <details>, sans flash.
        animation = reponse.animate(
          { height: [`${depart}px`, '0px'] },
          { duration: 260, easing: COURBE, fill: 'forwards' },
        );
        texte = reponse.animate({ opacity: [1, 0] }, { duration: 180, easing: 'ease-out', fill: 'forwards' });
        animation.onfinish = () => {
          item.open = false;
          item.classList.remove('se-ferme');
          texte?.cancel();
          animation?.cancel();
          animation = null;
        };
      }
    });
  }
</script>
