---
// Questions fréquentes : liste de questions dépliables (<details>), fonctionne sans JS.
// Seules les questions s'affichent d'emblée ; la réponse s'ouvre au clic ou au clavier.
import { MOI } from '../../lib/moi';
import T from './T.astro';
---

<div class="faq">
  {
    MOI.faq.map((f) => (
      <details class="faq-item">
        <summary>
          <h3 class="faq-q">
            <T texte={f.q} />
          </h3>
          <span class="faq-signe" aria-hidden="true" />
        </summary>
        <div class="faq-r">
          <p>
            <T texte={f.r} />
          </p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    max-width: 52rem;
    margin-top: 1.5rem;
    border-bottom: 1px solid var(--encre);
  }

  .faq-item {
    border-top: 1px solid var(--encre);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.75rem;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 3px solid var(--dore);
    outline-offset: 3px;
  }

  .faq-q {
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.3;
  }

  /* Signe + dessiné en CSS, qui devient − à l'ouverture (la barre verticale se couche). */
  .faq-signe {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 2px solid var(--dore);
    border-radius: 50%;
  }

  .faq-signe::before,
  .faq-signe::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.8rem;
    height: 2px;
    margin: -1px 0 0 -0.4rem;
    background: var(--dore);
  }

  .faq-signe::after {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-signe {
    background: var(--dore);
  }

  .faq-item[open] .faq-signe::before,
  .faq-item[open] .faq-signe::after {
    background: var(--sur-dore);
  }

  .faq-item[open] .faq-signe::after {
    transform: rotate(0deg);
  }

  .faq-r p {
    max-width: 40rem;
    padding-bottom: 1.1rem;
    padding-right: 3rem;
  }

  /* Mouvement à l'ouverture, déclenché par l'utilisateur : la réponse se déplie en 220 ms,
     ease-out marqué (réponse immédiate, arrivée douce), la barre du + se couche en même temps.
     Fermeture plus brève (160 ms) : on range, rien à regarder. Navigateurs sans ::details-content :
     ouverture instantanée, identique sans animation. */
  @media (prefers-reduced-motion: no-preference) {
    .faq-signe,
    .faq-signe::before,
    .faq-signe::after {
      transition:
        transform 220ms cubic-bezier(0.23, 1, 0.32, 1),
        background-color 160ms ease;
    }

    @supports selector(::details-content) {
      .faq {
        interpolate-size: allow-keywords;
      }

      .faq-item::details-content {
        height: 0;
        overflow: clip;
        opacity: 0;
        transition:
          height 160ms ease-in,
          opacity 120ms ease-in,
          content-visibility 160ms allow-discrete;
      }

      .faq-item[open]::details-content {
        height: auto;
        opacity: 1;
        transition:
          height 220ms cubic-bezier(0.23, 1, 0.32, 1),
          opacity 220ms cubic-bezier(0.23, 1, 0.32, 1) 40ms,
          content-visibility 220ms allow-discrete;
      }
    }
  }
</style>
