---
// Les trois gammes côte à côte (colonnes d'annuaire), l'abonnement et les options.
// `complet` : ajoute les options, autres services et conditions de paiement (page Tarifs).
// `illustre` : une illustration par gamme. `choix` : sur mobile, un sélecteur qui montre une gamme
// à la fois (boutons radio + CSS, sans JS) ; page Tarifs seulement (sur l'accueil, la section Modèles
// a déjà son sélecteur de gamme : les trois offres s'y suivent).
// Un point « Tout l'Essentiel » / « Tout le Vitrine » devient la phrase d'introduction de la liste.
import { MOI, prixFr } from '../../lib/moi';
import { sitesParSecteur } from '../../lib/sites';
import { lienSite } from '../../lib/liens';
import { infosSecteur } from '../../lib/secteurs';
import type { Site } from '../../lib/schema';
import T from './T.astro';
import { typoFr } from '../../lib/typo-fr';
import PilePages from './PilePages.astro';

interface Props {
  complet?: boolean;
  illustre?: boolean;
  choix?: boolean;
  /** Niveau du titre de chaque gamme. */
  niveau?: 2 | 3;
}
const { complet = false, illustre = false, choix = false, niveau = 3 } = Astro.props;
const estBase = (x: string) => /^Tout /.test(x);
const Titre = `h${niveau}` as 'h2' | 'h3';

// Un modèle d'exemple par gamme : celui du premier secteur qui l'a.
const exemples = new Map<string, Site>();
for (const sites of sitesParSecteur().values()) {
  for (const [g, s] of Object.entries(sites)) if (s && !exemples.has(g)) exemples.set(g, s);
}
---

<div class:list={['offres-bloc', { 'offres-choix': choix }]}>
{
  choix && (
    <fieldset class="of-choix">
      <legend class="visuellement-cache">Gamme affichée</legend>
      {MOI.gammes.map((g, i) => (
        <label class="of-onglet">
          <input
            class="visuellement-cache"
            type="radio"
            name="of-gamme"
            value={g.id}
            checked={i === Math.min(1, MOI.gammes.length - 1)}
          />
          <span class="of-o-nom">{g.nom}</span>
          <span class="of-o-prix mono">
            <T texte={prixFr(g.prix)} />
          </span>
        </label>
      ))}
    </fieldset>
  )
}
<div class="offres">
  {
    MOI.gammes.map((g) => {
      const exemple = exemples.get(g.id);
      return (
        <article class:list={['offre', `offre-${g.id}`]} data-gamme={g.id}>
          <div class="of-tete">
            <div>
              <Titre class="of-nom">{g.nom}</Titre>
              <p class="of-pourqui">
                <T texte={g.pourQui} />
              </p>
              <p class="of-prix mono">
                <T texte={prixFr(g.prix)} />
              </p>
            </div>
            {illustre && <PilePages pages={g.pages} class="of-pile" />}
          </div>
          <dl class="points of-faits">
            <div>
              <dt>Pages</dt>
              <dd class="valeur">{g.pages}</dd>
            </div>
            <div>
              <dt>Délai</dt>
              <dd class="valeur">{g.delai}</dd>
            </div>
          </dl>
          {g.inclus.filter(estBase).map((i) => (
            <p class="of-base">
              <T texte={typoFr(`${i}, plus :`)} />
            </p>
          ))}
          <ul class="of-inclus">
            {g.inclus.filter((i) => !estBase(i)).map((i) => (
              <li>
                <T texte={i} />
              </li>
            ))}
          </ul>
          {exemple && (
            <a class="of-exemple" href={lienSite(exemple)}>
              Ouvrir le modèle {g.nom}
              <span class="visuellement-cache"> ({infosSecteur(exemple.secteur).libelle}, entreprise fictive)</span>
            </a>
          )}
        </article>
      );
    })
  }
</div>
</div>
<p class="of-note"><T texte={MOI.noteDelais} /></p>

<div class="abonnement">
  <div class="ab-tete">
    <Titre class="ab-titre">Abonnement mensuel</Titre>
    <p class="ab-prix"><span class="mono"><T texte={prixFr(MOI.abonnement.prix)} /></span> par mois</p>
  </div>
  <ul class="ab-inclus">
    {
      MOI.abonnement.inclus.map((i) => (
        <li>
          <T texte={i} />
        </li>
      ))
    }
  </ul>
  <p class="ab-conditions"><T texte={MOI.abonnement.conditions} /></p>
</div>

{
  complet && MOI.options.length > 0 && (
    <div class="options">
      <Titre class="op-titre">Options</Titre>
      <ul class="points">
        {MOI.options.map((o) => (
          <li>
            <span>
              <T texte={o.nom} />
            </span>
            <span class="conduite" aria-hidden="true" />
            <span class="valeur mono">
              <T texte={prixFr(o.prix)} />
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  complet && MOI.autresServices.length > 0 && (
    <div class="options">
      <Titre class="op-titre">Autres services</Titre>
      <ul class="points services">
        {MOI.autresServices.map((s) => (
          <li>
            <span class="sv-nom">
              <T texte={s.nom} />
              <span class="sv-pour">
                <T texte={s.pourQui} />
              </span>
            </span>
            <span class="conduite" aria-hidden="true" />
            <span class="valeur">
              <T texte={prixFr(s.prix)} />
            </span>
          </li>
        ))}
      </ul>
    </div>
  )
}

{
  complet && MOI.paiement.length > 0 && (
    <div class="options">
      <Titre class="op-titre">Paiement</Titre>
      <ul class="paiement">
        {MOI.paiement.map((p) => (
          <li>
            <T texte={p} />
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .offres {
    display: grid;
    margin-top: 2rem;
  }

  .offre {
    padding-block: 1.25rem 1.5rem;
    border-top: 1px solid var(--filet);
  }

  .of-tete {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
  }

  .of-tete :global(.of-pile) {
    flex: none;
    width: 4.5rem;
  }

  /* Sélecteur de gamme (page Tarifs, mobile) : mêmes onglets que « Taille du site » de l'accueil. */
  .of-choix {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    min-width: 0;
    margin: 2rem 0 0;
    padding: 0;
    border: 1px solid var(--filet);
  }

  .of-onglet {
    display: grid;
    align-content: center;
    gap: 0.1rem;
    min-height: 3.5rem;
    padding: 0.45rem 0.6rem;
    cursor: pointer;
    background: var(--feuille);
    transition:
      background-color 150ms ease,
      color 150ms ease,
      transform 120ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .of-onglet + .of-onglet {
    border-left: 1px solid var(--filet);
  }

  .of-onglet:active {
    transform: scale(0.97);
  }

  .of-o-nom {
    font-weight: var(--graisse-titres);
    line-height: 1.2;
  }

  .of-o-prix {
    font-size: 0.875rem;
    line-height: 1.2;
  }

  .of-onglet:has(input:checked) {
    background: var(--dore);
    color: var(--sur-dore);
  }

  .of-onglet:has(input:focus-visible) {
    outline: 3px solid var(--dore);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .of-onglet:not(:has(input:checked)):hover {
      background: rgb(201 164 76 / 0.14);
    }
  }

  /* Une gamme à la fois sous 60 rem ; sans :has(), les trois restent affichées. */
  @media (max-width: 59.99rem) {
    .offres-choix .offres {
      margin-top: 0;
    }

    .offres-choix .offre {
      border-top: 0;
    }

    .offres-choix:has(input[value='essentiel']:checked) .offre:not(.offre-essentiel),
    .offres-choix:has(input[value='vitrine']:checked) .offre:not(.offre-vitrine),
    .offres-choix:has(input[value='premium']:checked) .offre:not(.offre-premium) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .of-onglet:active {
      transform: none;
    }
  }

  .of-nom {
    font-size: 1.5rem;
    font-weight: var(--graisse-titres);
    letter-spacing: -0.01em;
  }

  .of-pourqui {
    margin-top: 0.15rem;
    color: var(--encre-2);
  }

  .of-prix {
    margin-top: 0.75rem;
    font-size: clamp(1.5rem, 3.2vw, 1.875rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .of-faits {
    margin-top: 0.75rem;
  }

  .of-base {
    margin-top: 0.75rem;
    font-weight: var(--graisse-forte);
  }

  .of-base + .of-inclus {
    margin-top: 0.25rem;
  }

  .of-inclus {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .of-inclus li {
    position: relative;
    padding-block: 0.15rem;
    padding-left: 1.1rem;
  }

  .of-inclus li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.55rem;
    border-top: 2px solid var(--dore);
  }

  .of-note {
    margin-top: 1rem;
    max-width: 44rem;
    color: var(--encre-2);
    font-size: 0.9375rem;
  }

  .of-exemple {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    font-weight: var(--graisse-lien);
    color: var(--dore);
  }

  /* Abonnement : posé entre deux filets, sans boîte pleine (plus léger dans la page). */
  .abonnement {
    display: grid;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--filet);
  }

  .ab-titre,
  .op-titre {
    font-size: 1.25rem;
    font-weight: var(--graisse-titres);
  }

  .ab-prix {
    margin-top: 0.15rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .ab-inclus {
    padding-left: 1.1rem;
  }

  .ab-conditions {
    color: var(--encre-2);
  }

  .options {
    margin-top: 2.5rem;
    max-width: 56rem;
  }

  .sv-nom {
    display: flex;
    flex-direction: column;
    max-width: 38rem;
  }

  .sv-pour {
    color: var(--encre-2);
    font-size: 0.9375rem;
  }

  .services .valeur {
    max-width: 16rem;
  }

  .paiement {
    margin-top: 0.5rem;
    padding-left: 1.1rem;
  }

  .paiement li + li {
    margin-top: 0.35rem;
  }

  .options .points {
    margin-top: 0.5rem;
  }

  @media (min-width: 48rem) {
    .abonnement {
      /* Le titre et le prix tiennent dans une colonne étroite : la liste prend la place. */
      grid-template-columns: minmax(12rem, 1fr) minmax(0, 3fr);
      padding-block: 1.5rem;
    }

    .ab-conditions {
      grid-column: 1 / -1;
    }
  }

  /* Trois colonnes seulement quand les listes y tiennent sans coupures à chaque ligne. */
  @media (min-width: 60rem) {
    .of-choix {
      display: none;
    }

    .offres {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid var(--filet);
    }

    .offre {
      padding-inline: 1.25rem;
      border-top: 0;
      border-left: 1px solid var(--filet);
    }

    .offre:first-child {
      padding-left: 0;
      border-left: 0;
    }

    /* « À qui sert la gamme » sur deux lignes réservées : les prix restent alignés. */
    .of-pourqui {
      min-height: 3em;
      line-height: 1.5;
    }
  }
</style>
