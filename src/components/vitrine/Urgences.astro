---
// Bloc urgences : situations prises en charge, plage horaire, délai réel s'il est fourni.
// Bande ardoise : le chemin court de la personne qui a une fuite.
import type { Site } from '../../lib/schema';
import TitreSection from './TitreSection.astro';
import Appeler from '../commun/Appeler.astro';
import { marquerAVerifier } from '../../lib/texte';

interface Props {
  site: Site;
  id?: string;
}
const { site, id = 'urgences' } = Astro.props;
const u = site.urgences?.actif ? site.urgences : undefined;
// Avec des premiers gestes : chaque situation porte son geste (une seule liste, pas deux).
// Sans : la liste courte des situations prises en charge.
const gestes = site.premiersGestes;
---

{
  u && (
    <section class="section-v surface-ardoise urgences-v" aria-labelledby={`titre-${id}`}>
      <div class="page-v">
        <TitreSection id={`titre-${id}`}>Urgences</TitreSection>
        {u.plage && <p class="uv-plage chiffres">{u.plage}</p>}
        <div class="uv-pied">
          <Appeler site={site} class="bouton-v" />
          {u.delai && (
            <p class="uv-delai">
              Délai d’intervention&nbsp;: <span set:html={marquerAVerifier(u.delai)} />
            </p>
          )}
        </div>
        {gestes.length > 0 ? (
          <div class="uv-gestes">
            <h3 id={`titre-${id}-gestes`}>En attendant mon arrivée</h3>
            <dl class="uv-cas">
              {gestes.map((g) => (
                <div>
                  <dt>{g.cas}</dt>
                  <dd>{g.geste}</dd>
                </div>
              ))}
            </dl>
          </div>
        ) : (
          u.cas?.length && (
            <ul class="uv-cas">
              {u.cas.map((c) => (
                <li>
                  <span class="uv-nom">{c}</span>
                </li>
              ))}
            </ul>
          )
        )}
      </div>
    </section>
  )
}

<style>
  .uv-plage {
    margin-top: var(--espace-1);
    color: var(--couleur-texte-secondaire);
    font-weight: 500;
  }

  .uv-cas {
    display: grid;
    gap: 0 var(--espace-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .uv-cas > * {
    padding-block: var(--espace-2);
    border-top: 1px solid var(--couleur-trait);
  }

  /* Le nom de la situation garde la taille d'affiche : c'est ce que cherche la personne. */
  .uv-cas dt,
  .uv-nom {
    font-stretch: var(--largeur-titres);
    font-weight: 700;
    font-size: var(--taille-3);
    line-height: 1.05;
    hyphens: manual;
  }

  .uv-cas dd {
    margin: var(--espace-1) 0 0;
    color: var(--couleur-texte-secondaire);
    line-height: 1.5;
  }

  .uv-pied {
    display: grid;
    gap: var(--espace-2);
    margin-top: var(--espace-3);
  }

  .uv-gestes {
    margin-top: var(--espace-4);
  }

  .uv-gestes h3 {
    margin-bottom: var(--espace-2);
    color: var(--couleur-texte-secondaire);
    font-family: inherit;
    font-size: var(--taille-texte);
    font-stretch: normal;
    font-weight: 600;
    line-height: 1.3;
  }

  .uv-delai {
    color: var(--couleur-texte-secondaire);
    font-size: var(--taille-petit);
  }

  @media (min-width: 48rem) {
    .uv-cas {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .uv-cas dt,
    .uv-nom {
      font-size: min(var(--taille-4), 2.6vw);
    }

    .uv-pied {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      column-gap: var(--espace-4);
    }
  }
</style>
