---
// Avis clients. Uniquement de vrais avis, tirés du JSON (confiance.avis).
// En démo sans avis réels : les avis fictifs de `confiance.avisExemples`, chacun marqué
// « Avis fictif », ou à défaut trois emplacements vides. Hors démo : jamais d'avis fictif
// (la construction échoue s'il en reste, voir src/lib/sites.ts).
import type { Site } from '../../lib/schema';

interface Avis {
  texte: string;
  auteur: string;
  commune?: string;
  date?: string;
  source?: string;
}

interface Props {
  site: Site;
  class?: string;
}
const { site, class: classe } = Astro.props;
const confiance = (site.confiance ?? {}) as { avis?: Avis[]; avisExemples?: Avis[] };
const valides = (liste?: Avis[]) => (liste ?? []).filter((a) => a?.texte && a?.auteur);
const avis = valides(confiance.avis);
const fictifs = avis.length === 0 && site.demo ? valides(confiance.avisExemples) : [];
const exemples = avis.length === 0 && fictifs.length === 0 && site.demo;
---

{
  avis.length > 0 && (
    <ul class:list={['avis-v', classe]}>
      {avis.map((a) => (
        <li>
          <figure>
            <blockquote>
              <p>{a.texte}</p>
            </blockquote>
            <figcaption>
              <span class="av-auteur">{a.auteur}</span>
              {[a.commune, a.date, a.source].filter(Boolean).map((x) => (
                <span class="av-meta"> · {x}</span>
              ))}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  )
}
{
  fictifs.length > 0 && (
    <div class:list={['avis-fictifs', classe]}>
      <p class="af-avertissement">
        Avis fictifs, rédigés pour la démonstration. Sur le site réel&nbsp;: vos avis Google, recopiés mot pour mot.
      </p>
      <ul class="avis-v">
        {fictifs.map((a) => (
          <li>
            <p class="af-marque">Avis fictif</p>
            <figure>
              <blockquote>
                <p>{a.texte}</p>
              </blockquote>
              <figcaption>
                <span class="av-auteur">{a.auteur}</span>
                {[a.commune, a.date].filter(Boolean).map((x) => (
                  <span class="av-meta"> · {x}</span>
                ))}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  )
}
{
  exemples && (
    <ul class:list={['avis-v', 'avis-exemples', classe]} aria-label="Emplacements d’avis (démonstration)">
      {[0, 1, 2].map(() => (
        <li>
          <p class="av-marque">Exemple d’avis</p>
          <p class="av-consigne">
            Emplacement pour un avis client réel, recopié mot pour mot depuis sa source.
          </p>
          <p class="av-champs">Prénom et initiale · commune · mois et année · source (Google…)</p>
        </li>
      ))}
    </ul>
  )
}

<style>
  .avis-v {
    display: grid;
    gap: var(--espace-3);
    list-style: none;
    padding: 0;
  }

  .avis-v > li {
    padding-top: var(--espace-2);
    border-top: 2px solid var(--couleur-texte);
  }

  blockquote p {
    font-size: var(--taille-1);
    line-height: 1.4;
  }

  figcaption {
    margin-top: var(--espace-1);
    font-size: var(--taille-petit);
  }

  .av-auteur {
    font-weight: 700;
  }

  .av-meta {
    color: var(--couleur-texte-secondaire);
  }

  /* Démo : emplacements clairement distincts d'un vrai avis */
  .avis-exemples > li {
    padding: var(--espace-2);
    border: 2px dashed var(--couleur-trait);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .av-marque {
    font-weight: 700;
  }

  /* Démo : avis fictifs, signalés en tête de liste et sur chaque avis */
  .af-avertissement {
    margin-bottom: var(--espace-2);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: var(--taille-petit);
    color: var(--couleur-texte-secondaire);
  }

  .af-marque {
    display: inline-block;
    margin-bottom: var(--espace-1);
    padding: 0.15em 0.5em;
    border: 1px dashed currentColor;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: var(--taille-petit);
    font-weight: 700;
    color: var(--couleur-texte-secondaire);
  }

  .av-consigne,
  .av-champs {
    margin-top: 0.35rem;
    color: var(--couleur-texte-secondaire);
    font-size: var(--taille-petit);
  }

  @media (min-width: 48rem) {
    .avis-v {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
