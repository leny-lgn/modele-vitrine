---
// Avis clients. Uniquement de vrais avis, tirés du JSON (confiance.avis).
// En démo sans avis réels : les avis fictifs de `confiance.avisExemples`, chacun marqué
// « Avis fictif », ou à défaut trois emplacements vides. Hors démo : jamais d'avis fictif
// (la construction échoue s'il en reste, voir src/lib/sites.ts).
import type { Site } from '../../lib/schema';

interface Avis {
  texte: string;
  auteur: string;
  commune?: string;
  date?: string;
  source?: string;
  /** Groupe de services concerné (« Dépannage »…), pour n'afficher que les avis d'une page de service. */
  groupe?: string;
}

interface Props {
  site: Site;
  class?: string;
  /** Pages de service : seulement les avis de ce groupe, et rien (pas d'emplacements vides) s'il n'y en a pas. */
  groupe?: string;
}
const { site, class: classe, groupe } = Astro.props;
const confiance = (site.confiance ?? {}) as { avis?: Avis[]; avisExemples?: Avis[] };
const valides = (liste?: Avis[]) =>
  (liste ?? []).filter((a) => a?.texte && a?.auteur && (!groupe || a.groupe === groupe));
const avis = valides(confiance.avis);
const fictifs = avis.length === 0 && site.demo ? valides(confiance.avisExemples) : [];
const exemples = avis.length === 0 && fictifs.length === 0 && site.demo && !groupe;
---

{
  avis.length > 0 && (
    <div class:list={['avis-reels', classe]}>
    <ul class="avis-v" data-avis-repliable>
      {avis.map((a) => (
        <li>
          <figure>
            <blockquote>
              <p>{a.texte}</p>
            </blockquote>
            <figcaption>
              <span class="av-auteur">{a.auteur}</span>
              {[a.commune, a.date, a.source].filter(Boolean).map((x) => (
                <span class="av-meta"> · {x}</span>
              ))}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    </div>
  )
}
{
  fictifs.length > 0 && (
    <div class:list={['avis-fictifs', classe]}>
      <p class="af-avertissement">
        Avis fictifs, rédigés pour la démonstration. Sur le site réel&nbsp;: vos avis Google, recopiés mot pour mot.
      </p>
      <ul class="avis-v" data-avis-repliable>
        {fictifs.map((a) => (
          <li>
            <p class="af-marque">Avis fictif</p>
            <figure>
              <blockquote>
                <p>{a.texte}</p>
              </blockquote>
              <figcaption>
                <span class="av-auteur">{a.auteur}</span>
                {[a.commune, a.date].filter(Boolean).map((x) => (
                  <span class="av-meta"> · {x}</span>
                ))}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  )
}
{
  exemples && (
    <ul class:list={['avis-v', 'avis-exemples', classe]} aria-label="Emplacements d’avis (démonstration)">
      {[0, 1, 2].map(() => (
        <li>
          <p class="av-marque">Exemple d’avis</p>
          <p class="av-consigne">
            Emplacement pour un avis client réel, recopié mot pour mot depuis sa source.
          </p>
          <p class="av-champs">Prénom et initiale · commune · mois et année · source (Google…)</p>
        </li>
      ))}
    </ul>
  )
}

<script>
  // Mobile : un seul avis affiché, les autres derrière « Voir les N autres avis ».
  // Sans JS, ou sur grand écran, tous les avis restent visibles.
  const mobile = window.matchMedia('(max-width: 47.99rem)');
  for (const liste of document.querySelectorAll<HTMLUListElement>('[data-avis-repliable]')) {
    const n = liste.children.length - 1;
    if (n < 1) continue;
    const bouton = document.createElement('button');
    bouton.type = 'button';
    bouton.className = 'av-plus';
    bouton.textContent = n > 1 ? `Voir les ${n} autres avis` : 'Voir l’autre avis';
    bouton.addEventListener('click', () => {
      liste.classList.remove('av-replie');
      bouton.remove();
      const suivant = liste.children[1] as HTMLElement | undefined;
      if (suivant) {
        suivant.tabIndex = -1;
        suivant.focus();
      }
    });
    liste.classList.add('av-replie');
    liste.after(bouton);
    const suivre = () => (bouton.hidden = !mobile.matches);
    suivre();
    mobile.addEventListener('change', suivre);
  }
</script>

<style>
  @media (max-width: 47.99rem) {
    .av-replie > li:nth-child(n + 2) {
      display: none;
    }
  }

  :global(.av-plus) {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: var(--espace-1);
    padding: 0;
    border: 0;
    background: none;
    color: var(--couleur-lien);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  :global(.av-plus[hidden]) {
    display: none;
  }

  .avis-v li:focus {
    outline: none;
  }

  .avis-v {
    display: grid;
    gap: var(--espace-3);
    list-style: none;
    padding: 0;
  }

  .avis-v > li {
    padding-top: var(--espace-2);
    border-top: 2px solid var(--couleur-texte);
  }

  blockquote p {
    font-size: var(--taille-1);
    line-height: 1.4;
  }

  figcaption {
    margin-top: var(--espace-1);
    font-size: var(--taille-petit);
  }

  .av-auteur {
    font-weight: 700;
  }

  .av-meta {
    color: var(--couleur-texte-secondaire);
  }

  /* Démo : emplacements clairement distincts d'un vrai avis */
  .avis-exemples > li {
    padding: var(--espace-2);
    border: 2px dashed var(--couleur-trait);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  .av-marque {
    font-weight: 700;
  }

  /* Démo : avis fictifs, signalés en tête de liste et sur chaque avis */
  .af-avertissement {
    margin-bottom: var(--espace-2);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: var(--taille-petit);
    color: var(--couleur-texte-secondaire);
  }

  .af-marque {
    display: inline-block;
    margin-bottom: var(--espace-1);
    padding: 0.15em 0.5em;
    border: 1px dashed currentColor;
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: var(--taille-petit);
    font-weight: 700;
    color: var(--couleur-texte-secondaire);
  }

  .av-consigne,
  .av-champs {
    margin-top: 0.35rem;
    color: var(--couleur-texte-secondaire);
    font-size: var(--taille-petit);
  }

  @media (min-width: 48rem) {
    .avis-v {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
