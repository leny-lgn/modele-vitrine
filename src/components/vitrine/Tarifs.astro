---
// Tableau des tarifs « à partir de » : sobre, chiffres tabulaires, mention TTC.
import type { Site } from '../../lib/schema';
import { contientAVerifier, contientExemple, marquerAVerifier } from '../../lib/texte';

interface Props {
  tarifs: NonNullable<Site['tarifs']>;
  /** Affiche l'information légale sur les prix des dépannages (page Tarifs). */
  infoPrix?: boolean;
  /** Affiche la mention TTC sous le tableau (masquée si la page l'affiche déjà en tête). */
  mention?: boolean;
  /** Affiche « Devis gratuit » sous le tableau (masqué si un encart voisin le dit déjà). */
  devis?: boolean;
  class?: string;
}
const { tarifs, infoPrix = false, mention = true, devis = true, class: classe } = Astro.props;
const texteMention = mention ? tarifs.mention : undefined;
const devisGratuit = devis && tarifs.devisGratuit;
// Démo : prix d'exemple ou laissés à remplir, une seule ligne le dit avant le tableau.
const prixExemple = tarifs.lignes.some((l) => contientExemple(l.prix));
const prixARemplir = !prixExemple && tarifs.lignes.some((l) => contientAVerifier(l.prix));
// « à partir de » en petit au-dessus du montant : sur mobile, le prix ne se coupe plus au hasard.
const prix = (texte: string) =>
  marquerAVerifier(texte, 'votre tarif', 'aucune').replace(
    /^(à partir de)(?:\s|&nbsp;|\u00a0)+/i,
    '<span class="tv-apartir">$1</span> ',
  );
---

<div class:list={['tarifs-v', classe]}>
  {prixExemple && <p class="tv-demo">Prix d’exemple pour la démonstration. Sur votre site&nbsp;: vos prix réels.</p>}
  {prixARemplir && <p class="tv-demo">Exemple de grille. Sur votre site&nbsp;: vos prix réels.</p>}
  <table>
    <thead>
      <tr>
        <th scope="col">Prestation</th>
        <th scope="col">Prix TTC</th>
      </tr>
    </thead>
    <tbody>
      {
        tarifs.lignes.map((l) => (
          <tr>
            <th scope="row">{l.libelle}</th>
            <td class="chiffres" set:html={prix(l.prix)} />
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    (texteMention || devisGratuit) && (
      <p class="tv-mention">
        {texteMention}
        {devisGratuit && <strong class="tv-devis"> Devis gratuit.</strong>}
      </p>
    )
  }
  {tarifs.compris && <p class="tv-compris" set:html={marquerAVerifier(tarifs.compris)} />}
  {infoPrix && tarifs.infoPrix && <p class="tv-legal" set:html={marquerAVerifier(tarifs.infoPrix)} />}
</div>

<style>
  .tarifs-v {
    max-width: 44rem;
  }

  .tv-demo {
    margin: 0 0 0.75rem;
    color: var(--couleur-texte-secondaire);
    font-size: var(--taille-petit);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  thead th {
    padding-bottom: 0.5rem;
    border-bottom: 2px solid var(--couleur-texte);
    color: var(--couleur-texte-secondaire);
    font-size: var(--taille-petit);
    font-weight: 500;
    text-align: left;
  }

  thead th:last-child,
  td {
    text-align: right;
  }

  tbody th,
  td {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--couleur-trait);
    vertical-align: baseline;
  }

  tbody th {
    padding-right: var(--espace-2);
    font-weight: 500;
    text-align: left;
  }

  td {
    font-weight: 700;
    white-space: nowrap;
  }

  td :global(.tv-apartir) {
    color: var(--couleur-texte-secondaire);
    font-size: var(--taille-petit);
    font-weight: 500;
  }

  /* Petit écran : « à partir de » sur sa ligne, en petit, au-dessus du montant. */
  @media (max-width: 30rem) {
    td {
      white-space: normal;
      min-width: 6rem;
    }

    td :global(.tv-apartir) {
      display: block;
      line-height: 1.2;
    }
  }

  .tv-compris {
    max-width: 38rem;
    margin-top: var(--espace-2);
    line-height: 1.5;
  }

  .tv-mention,
  .tv-legal {
    margin-top: var(--espace-2);
    color: var(--couleur-texte-secondaire);
    font-size: var(--taille-petit);
  }

  .tv-devis {
    color: var(--couleur-texte);
  }

  .tv-legal {
    max-width: 38rem;
  }
</style>
