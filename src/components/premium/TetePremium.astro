---
// Tête des pages internes Premium. Sur bureau, la conduite arrive par la gauche en face
// du titre (voir Fil, entree="gauche") ; sous elle, dans la zone gauche, une fiche courte :
// disponibilité (statut + urgences), numéro, zone, devis gratuit. Tout vient du JSON.
// Sur mobile, seule la disponibilité reste en tête (le numéro est dans la barre Appeler).
// Slot « zg » : ajouté en tête de la zone gauche (ex. fiche d'un chantier).
import type { Site } from '../../lib/schema';
import Disponibilite from '../commun/Disponibilite.astro';
import { echapper } from '../../lib/texte';
import { telephoneFr, telHref } from '../../lib/typo-fr';

interface Props {
  site: Site;
  titre: string;
  intro?: string;
  /** Disponibilité + Appeler sous le contenu de la zone gauche (désactiver si le slot les contient déjà). */
  contact?: boolean;
}
const { site, titre, intro, contact = true } = Astro.props;
const zgPerso = Astro.slots.has('zg');
// Les noms composés (« Saint-Exemple ») ne se coupent pas au trait d'union dans le grand titre.
const titreHtml = titre
  .split(' ')
  .map((m) => (m.includes('-') ? `<span class="insecable">${echapper(m)}</span>` : echapper(m)))
  .join(' ');
---

<section class="tete-p pg" aria-labelledby="titre-page">
  <h1 id="titre-page" class="tp-titre" set:html={titreHtml} />
  <div class="zg tp-zg">
    {zgPerso && <slot name="zg" />}
    {
      contact && (
        <div class="tp-contact">
          <Disponibilite site={site} compact />
          <dl class="tp-fiche">
            <div class="tp-tel">
              <dt>Téléphone</dt>
              <dd>
                <a class="chiffres" href={telHref(site.telephone)}>{telephoneFr(site.telephone)}</a>
              </dd>
            </div>
            {site.zone.rayonKm && (
              <div>
                <dt>Zone</dt>
                <dd>
                  {site.zone.rayonKm}&nbsp;km autour de {site.adresse.ville}
                </dd>
              </div>
            )}
            {site.tarifs?.devis && (
              <div>
                <dt>Devis</dt>
                <dd>{site.tarifs.devis}</dd>
              </div>
            )}
          </dl>
        </div>
      )
    }
  </div>
  {intro && <p class="tp-intro">{intro}</p>}
  <slot />
</section>

<style>
  .tete-p {
    --rangs: 4;
    padding-top: var(--haut-tete);
    padding-bottom: var(--espace-4);
    row-gap: var(--espace-3);
  }

  .tp-titre {
    /* Plafond en vw : « THERMODYNAMIQUE » (un seul mot, jamais coupé) tient dans un écran de 375 px. */
    font-size: min(var(--titre-page), 9.6vw);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: 0;
    max-width: 15ch;
    overflow-wrap: normal;
  }

  .tp-intro {
    max-width: 36rem;
    font-size: var(--taille-2);
    line-height: 1.3;
  }

  .tp-zg {
    display: grid;
    gap: var(--espace-3);
    align-content: start;
  }

  .tp-contact {
    display: grid;
    gap: var(--espace-2);
    justify-items: start;
  }

  /* Fiche : mêmes filets que les annotations du plan ; numéro en grand, en cuivre. */
  .tp-fiche {
    display: grid;
    width: 100%;
    margin: 0;
    border-top: 1px solid var(--couleur-trait);
    font-size: var(--taille-petit);
  }

  .tp-fiche > div {
    display: grid;
    gap: 0.1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--couleur-trait);
  }

  .tp-fiche dt {
    font-weight: 700;
  }

  .tp-fiche dd {
    margin: 0;
    color: var(--couleur-texte-secondaire);
  }

  .tp-tel a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--cuivre-fonce);
    font-size: var(--taille-2);
    font-weight: 700;
    text-decoration: none;
  }

  /* Mobile : disponibilité d'abord ; la fiche n'apparaît pas (numéro dans la barre Appeler,
     zone et devis plus bas dans la page). */
  @media (max-width: 55.99rem) {
    .tp-contact {
      order: -1;
    }

    .tp-fiche {
      display: none;
    }
  }

  @media (min-width: 56rem) {
    .tete-p {
      padding-bottom: var(--espace-4);
    }

    /* Sous la conduite d'arrivée, qui passe à hauteur des capitales du titre */
    .tp-zg {
      padding-top: calc(var(--titre-page) * 0.4 + var(--espace-4));
    }
  }
</style>
