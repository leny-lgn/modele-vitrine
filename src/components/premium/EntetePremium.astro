---
// En-tête Premium : bandeau ardoise, nom en capitales condensées comme une plaque,
// pages, téléphone. Fixé en haut sur bureau. Mobile : menu dépliant sans JS (<details>),
// l'appel passe par la barre du bas.
import type { Site, CleePage } from '../../lib/schema';
import type { CibleLien } from '../../lib/liens';
import { lienSite } from '../../lib/liens';
import { LIBELLES_PAGES } from '../../lib/secteurs';
import { telephoneFr, telHref } from '../../lib/typo-fr';

interface Props {
  site: Site;
  page: CibleLien;
}
const { site, page } = Astro.props;
const pages = (site.pages as CleePage[]).filter((p) => p !== 'accueil');
const courant = (p: CleePage) => (p === page ? 'page' : undefined);
---

<header class="entete-p surface-ardoise">
  <div class="ep-grille">
    <a class="ep-nom" href={lienSite(site)} aria-current={page === 'accueil' ? 'page' : undefined}>{site.nom}</a>
    <nav class="ep-nav" aria-label="Pages du site">
      <ul class="ep-liste">
        {
          pages.map((p) => (
            <li>
              <a href={lienSite(site, p)} aria-current={courant(p)}>
                {LIBELLES_PAGES[p]}
              </a>
            </li>
          ))
        }
      </ul>
      <details class="ep-menu">
        <summary>Menu</summary>
        <ul>
          <li><a href={lienSite(site)} aria-current={page === 'accueil' ? 'page' : undefined}>Accueil</a></li>
          {
            pages.map((p) => (
              <li>
                <a href={lienSite(site, p)} aria-current={courant(p)}>
                  {LIBELLES_PAGES[p]}
                </a>
              </li>
            ))
          }
        </ul>
      </details>
    </nav>
    <a class="ep-tel chiffres" href={telHref(site.telephone)}>
      <span class="ep-tel-libelle">Appeler le&nbsp;</span>{telephoneFr(site.telephone)}
    </a>
  </div>
</header>

<style>
  .entete-p {
    position: relative;
    z-index: 40;
  }

  .ep-grille {
    display: flex;
    align-items: center;
    gap: var(--espace-2);
    max-width: var(--largeur-page);
    min-height: 3.5rem;
    margin-inline: auto;
    padding-inline: var(--marge-page);
  }

  .ep-nom {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-right: auto;
    font-stretch: 75%;
    font-weight: 800;
    font-size: var(--taille-1);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    text-decoration: none;
    hyphens: manual;
  }

  .ep-nav ul {
    list-style: none;
    padding: 0;
  }

  .ep-nav a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }

  .ep-nav a[aria-current='page'] {
    color: var(--cuivre-clair);
    font-weight: 700;
  }

  .ep-liste {
    display: none;
  }

  .ep-menu {
    position: relative;
  }

  .ep-menu summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    border: 1px solid currentColor;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .ep-menu summary::-webkit-details-marker {
    display: none;
  }

  .ep-menu summary::before {
    content: '';
    width: 0.875rem;
    height: 0.5rem;
    border-block: 2px solid currentColor;
  }

  .ep-menu[open] summary::before {
    height: 2px;
    border-bottom: 0;
  }

  .ep-menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.5rem);
    min-width: 14rem;
    padding: 0.5rem 0;
    background: var(--ardoise);
    border: 1px solid var(--gris-joint);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.25);
  }

  .ep-menu a {
    padding-inline: 1rem;
    font-size: var(--taille-1);
  }

  .ep-tel {
    display: none;
  }

  @media (min-width: 56rem) {
    .ep-menu {
      display: none;
    }

    .ep-liste {
      display: flex;
      gap: 0 1.25rem;
    }

    .ep-nav a:hover {
      color: var(--cuivre-clair);
    }

    .ep-tel {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      padding-inline: 1rem;
      background: var(--cuivre-clair);
      color: var(--ardoise);
      font-weight: 700;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 150ms ease-out;
    }

    .ep-tel:hover {
      background: #e8a578;
    }

    .ep-tel-libelle {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  @media (min-width: 40rem) {
    .ep-nom {
      font-size: var(--taille-2);
    }
  }

  @media (min-width: 72rem) {
    .entete-p {
      position: sticky;
      top: 0;
    }

    .ep-grille {
      gap: var(--espace-3);
      min-height: 4rem;
    }

    .ep-tel-libelle {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
  }
</style>
