---
// Contact : téléphone, e-mail, villes, zone et disponibilités.
import Perso from '../layouts/Perso.astro';
import BandeauPage from '../components/perso/BandeauPage.astro';
import Coordonnees from '../components/perso/Coordonnees.astro';
import T from '../components/perso/T.astro';
import { MOI } from '../lib/moi';

const premiere = MOI.etapes[0];
const preparer = MOI.preparerEchange;
---

<Perso titre="Contact" description={`Contact : téléphone, e-mail et zone d’intervention. ${MOI.accroche}`}>
  <BandeauPage titre="Contact" />
  <div class="suite-page">
  <div class="page page-large tete">
    <Coordonnees />
    <div class="cote">
      {
        premiere && (
          <div class="suite">
            <h2 class="su-titre">Après votre appel</h2>
            <p>
              <T texte={premiere.texte} />
            </p>
          </div>
        )
      }
      {
        preparer && (
          <div class="suite preparer">
            <h2 class="su-titre">
              <T texte={preparer.titre} />
            </h2>
            <p>
              <T texte={preparer.intro} />
            </p>
            <ul class="pr-liste">
              {preparer.points.map((x) => (
                <li>
                  <T texte={x} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
  </div>
</Perso>

<style>
  .tete {
    padding-top: 1rem;
  }

  .suite {
    margin-top: 2.5rem;
    max-width: 40rem;
  }

  /* Grand écran : la fiche à gauche, la suite à droite, pour occuper toute la largeur. */
  @media (min-width: 64rem) {
    .tete {
      display: grid;
      grid-template-columns: minmax(0, 44rem) minmax(0, 1fr);
      gap: 0 4rem;
      align-items: start;
    }

    .suite {
      margin-top: 1.5rem;
      padding: 1.5rem;
      border: 1px solid var(--filet);
    }

    .suite + .suite {
      margin-top: 1.25rem;
    }
  }

  .su-titre {
    font-size: 1.25rem;
    font-weight: var(--graisse-titres);
  }

  .suite p {
    margin-top: 0.3rem;
  }

  .pr-liste {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .pr-liste li {
    position: relative;
    padding-block: 0.2rem;
    padding-left: 1.1rem;
  }

  .pr-liste li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.85em;
    width: 0.55rem;
    border-top: 2px solid var(--dore);
  }

</style>
