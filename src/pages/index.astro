---
// Accueil provisoire du site personnel, remplacé à l'étape suivante (accueil en annuaire).
import Neutre from '../layouts/Neutre.astro';
import { LIEN_GRILLE } from '../lib/liens';
import { NOM } from '../lib/moi';
---

<Neutre titre={NOM} description="Sites internet pour les commerçants et artisans.">
  <h1>{NOM}</h1>
  <p class="intro">Site en préparation. En attendant, les modèles de sites vitrines sont en ligne.</p>
  <p><a href={LIEN_GRILLE}>Voir les modèles</a></p>
</Neutre>

<style>
  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  .intro {
    margin-top: 0.75rem;
    color: var(--couleur-texte-secondaire);
  }

  a {
    display: inline-block;
    margin-top: 1rem;
    padding-block: 0.6rem;
    font-weight: 600;
  }
</style>
