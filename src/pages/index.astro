---
// Accueil du site personnel : une page d'annuaire. Données : src/data/moi.json.
import Perso from '../layouts/Perso.astro';
import Appeler from '../components/perso/Appeler.astro';
import TrouverAnnonce from '../components/perso/TrouverAnnonce.astro';
import EssaiTelephone from '../components/perso/EssaiTelephone.astro';
import FondAnnuaire from '../components/perso/FondAnnuaire.astro';
import Apercus from '../components/perso/Apercus.astro';
import Etapes from '../components/perso/Etapes.astro';
import QuiJeSuis from '../components/perso/QuiJeSuis.astro';
import Faq from '../components/perso/Faq.astro';
import Offres from '../components/perso/Offres.astro';
import T from '../components/perso/T.astro';
import { MOI, NOM, aCompleter, prixPlancher, villesFr } from '../lib/moi';
import { typoFr } from '../lib/typo-fr';
import { LIEN_GRILLE, LIEN_TARIFS } from '../lib/liens';

const description = MOI.accroche;
const email = aCompleter(MOI.email) ? undefined : MOI.email;
const autreMetier = typoFr(
  'Votre métier n’est pas encore dans les modèles ? Le site se construit de la même façon : appelez-moi pour en parler.',
);
---

<Perso description={description}>
  <section class="ouverture" aria-labelledby="titre-page">
    <FondAnnuaire class="fond-bandeau" lignes={120} graine={3} />
    <div class="page page-large ouverture-contenu">
    <h1 id="titre-page" class="rubrique rubrique-h1">
      <span>Sites internet</span><span class="visuellement-cache"> à </span>
      <span class="r-lieu">{villesFr()}</span>
    </h1>
    <div class="annonce-perso">
      <div class="ap-qui">
        <p class="ap-nom"><T texte={NOM} /></p>
        <p class="ap-accroche"><T texte={MOI.accroche} /></p>
        <p class="ap-bref"><T texte={MOI.enBref} /></p>
      </div>
      <div class="ap-contact">
        {
          email ? (
            <a class="ap-email" href={`mailto:${email}`}>
              {email.split('@')[0]}
              <wbr />@{email.split('@')[1]}
            </a>
          ) : (
            <p class="ap-email">
              <T texte={MOI.email} />
            </p>
          )
        }
        <p class="ap-prix">
          Site complet dès <strong class="mono"><T texte={prixPlancher()} /></strong>
        </p>
        <div class="ap-actions">
          <Appeler class="ap-appeler" />
          <a class="bouton bouton-trait" href="#modeles">Voir les modèles</a>
        </div>
      </div>
    </div>
    <Apercus />
    </div>
  </section>

  <section id="modeles" class="section bande bande-sombre" aria-labelledby="titre-modeles">
    <div class="page page-large">
      <h2 id="titre-modeles" class="titre-section">Les modèles</h2>
      <p class="intro-section">
        {
          typoFr(
            'Choisissez votre métier et la taille de votre site : l’annonce grandit avec la gamme. Chaque modèle est un site complet que vous pouvez parcourir. Les entreprises sont fictives.',
          )
        }
      </p>
      <TrouverAnnonce />
      <EssaiTelephone />
      <p class="autre-metier">{autreMetier}</p>
      <p class="suite"><a href={LIEN_GRILLE}>Tous les modèles, par métier</a></p>
    </div>
  </section>

  <section id="tarifs" class="section bande bande-bois" aria-labelledby="titre-tarifs">
    <div class="page page-large">
    <h2 id="titre-tarifs" class="titre-section">Tarifs</h2>
    <Offres illustre />
    <aside class="tarifs-aide" aria-label="Choisir une gamme">
      <p class="ta-titre">{typoFr('Vous hésitez entre deux gammes ?')}</p>
      <p>
        Ouvrez les deux modèles, puis <span class="sans-coupure">appelez-moi</span>&nbsp;: nous verrons ensemble la
        gamme qui convient à votre commerce.
      </p>
      <Appeler />
    </aside>
    <p class="suite"><a href={LIEN_TARIFS}>Ce que comprend chaque gamme, options et conditions</a></p>
    </div>
  </section>

  <section class="page page-large section" aria-labelledby="titre-etapes">
    <h2 id="titre-etapes" class="titre-section">Déroulement d’un projet</h2>
    <Etapes />
  </section>

  <section class="page page-large section" aria-labelledby="titre-qui">
    <h2 id="titre-qui" class="titre-section">Qui je suis</h2>
    <QuiJeSuis />
  </section>

  {
    MOI.realisations.length > 0 && (
      <section class="page page-large section" aria-labelledby="titre-realisations">
        <h2 id="titre-realisations" class="titre-section">Réalisations</h2>
        <ul class="points realisations">
          {MOI.realisations.map((r) => (
            <li>
              <a href={r.url}>{r.nom}</a>
              <span class="conduite" aria-hidden="true" />
              <span class="valeur">
                {r.metier}, {r.ville}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="page page-large section" aria-labelledby="titre-faq">
    <h2 id="titre-faq" class="titre-section">Questions fréquentes</h2>
    <Faq />
  </section>

</Perso>

<style>
  /* Bandeau pleine largeur : une page d'annuaire en vert sur vert, votre annonce posée dessus en blanc.
     Les lignes de fond sont du décor (gris bleuté sur anthracite, sans texte). */
  .ouverture {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: 1rem 1.5rem;
    background: var(--nuit-fonce);
  }

  .ouverture :global(.fond-bandeau) {
    z-index: -1;
    --barre: #182023;
    --barre-forte: #212a2e;
  }

  .ouverture .rubrique-h1 {
    padding: 0 0 0.6rem;
    border-bottom: 0;
    background: none;
  }

  .annonce-perso {
    display: grid;
    gap: 1.25rem;
    padding: 1.1rem 1rem 1.25rem;
    border: 3px solid var(--dore);
    background: var(--feuille);
  }

  .ap-nom {
    font-size: clamp(2rem, 7.5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
    hyphens: manual;
    text-wrap: balance;
  }

  .ap-accroche {
    hyphens: manual;
    margin-top: 0.75rem;
    max-width: 34rem;
    font-size: clamp(1.125rem, 2.2vw, 1.375rem);
    line-height: 1.4;
  }

  /* L'adresse e-mail au premier plan (le numéro est dans le bouton Appeler, à côté).
     Taille calée pour que l'adresse tienne sur une ligne à 375 px. */
  .ap-email {
    font-size: clamp(1.25rem, 5.4vw, 1.875rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.15;
    hyphens: none;
  }

  .ap-prix {
    margin-top: 0.4rem;
    font-size: 1.125rem;
  }

  .ap-prix strong {
    font-size: 1.375rem;
    font-weight: 600;
  }

  .ap-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.9rem;
  }

  .ap-bref {
    hyphens: manual;
    margin-top: 0.5rem;
    max-width: 34rem;
    color: var(--encre-2);
  }

  a.ap-email {
    display: inline-block;
    color: inherit;
    text-decoration: none;
  }


  .autre-metier {
    margin-top: 2rem;
    max-width: 40rem;
  }

  .tarifs-aide {
    max-width: 44rem;
    margin-top: 2rem;
    padding: 1.25rem;
    border: 3px solid var(--encre);
  }

  .tarifs-aide > * + * {
    margin-top: 0.75rem;
  }

  .sans-coupure {
    white-space: nowrap;
  }

  .ta-titre {
    font-size: 1.375rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .suite {
    margin-top: 1.5rem;
  }

  .suite a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 700;
  }

  .realisations {
    margin-top: 1.5rem;
    max-width: 44rem;
  }

  @media (max-width: 29.99rem) {
    .ap-actions > :global(*) {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 48rem) {
    .ouverture {
      padding-block: 2.5rem 3.5rem;
    }
  }

  /* Deux colonnes seulement quand le téléphone et les boutons y tiennent sans déborder. */
  @media (min-width: 60rem) {
    /* L'annonce n'occupe pas toute la largeur : à droite, la page d'annuaire continue. */
    .annonce-perso {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 0;
      max-width: 56rem;
      padding: 0;
    }

    .ouverture :global(.fond-bandeau .fa-defile) {
      columns: 3;
    }

    .ap-qui {
      padding: 2rem 2rem 2.25rem;
    }

    .ap-contact {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 2rem;
      border-left: 1px solid var(--encre);
    }

    .ap-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Grand écran : l'annonce à gauche, l'aperçu du travail à droite.
     L'annonce passe en une colonne (identité, puis numéro et boutons côte à côte). */
  @media (min-width: 64rem) {
    .ouverture-contenu {
      display: grid;
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      column-gap: 3.5rem;
      align-items: end;
    }

    .ouverture .rubrique-h1 {
      grid-column: 1 / -1;
    }

    .annonce-perso {
      grid-template-columns: minmax(0, 1fr);
      max-width: none;
    }

    .ap-qui {
      padding: 2rem 2rem 1.5rem;
    }

    .ap-contact {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: 0 1.5rem;
      padding: 1.5rem 2rem 2rem;
      border-left: 0;
      border-top: 1px solid var(--encre);
    }

    /* Colonne étroite à côté des boutons : l'adresse ne passe à la ligne qu'avant « @ ». */
    .ap-email {
      font-size: 1.5rem;
    }

    .ap-actions {
      grid-column: 2;
      grid-row: 1 / 3;
      margin-top: 0;
    }
  }

  /* Arrivée, seulement à la première page vue de la session (marque posée par Perso.astro) :
     la rubrique se trace, le cadre se découvre de haut en bas, puis le texte arrive en cascade
     (60 ms d'écart). En revenant sur l'accueil, tout est déjà en place : pas de sursaut.
     Entrée → ease-out marqué. Le numéro est en place avant 600 ms. Sans JS : pas d'animation. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-premiere-visite]) .ouverture .rubrique-h1 {
      animation: trace-rubrique 520ms cubic-bezier(0.23, 1, 0.32, 1) backwards;
    }

    :global(html[data-premiere-visite]) .annonce-perso {
      animation: decouvre-cadre 520ms cubic-bezier(0.23, 1, 0.32, 1) 100ms backwards;
    }

    :global(html[data-premiere-visite]) .ap-qui > *,
    :global(html[data-premiere-visite]) .ap-contact > * {
      animation: arrive-texte 360ms cubic-bezier(0.23, 1, 0.32, 1) backwards;
    }

    :global(html[data-premiere-visite]) .ap-qui > :nth-child(1) {
      animation-delay: 160ms;
    }
    :global(html[data-premiere-visite]) .ap-qui > :nth-child(2) {
      animation-delay: 220ms;
    }
    :global(html[data-premiere-visite]) .ap-qui > :nth-child(3) {
      animation-delay: 280ms;
    }
    :global(html[data-premiere-visite]) .ap-contact > :nth-child(1) {
      animation-delay: 200ms;
    }
    :global(html[data-premiere-visite]) .ap-contact > :nth-child(2) {
      animation-delay: 260ms;
    }
    :global(html[data-premiere-visite]) .ap-contact > :nth-child(3) {
      animation-delay: 320ms;
    }
  }

  @keyframes trace-rubrique {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes decouvre-cadre {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes arrive-texte {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }
</style>
