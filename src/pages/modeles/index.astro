---
// Tous les modèles, par métier : l'annuaire en grand. Généré depuis src/sites/.
import Perso from '../../layouts/Perso.astro';
import BandeauPage from '../../components/perso/BandeauPage.astro';
import Rubrique from '../../components/perso/Rubrique.astro';
import { sitesParSecteur } from '../../lib/sites';
import { LIEN_TARIFS } from '../../lib/liens';
import { typoFr } from '../../lib/typo-fr';

const secteurs = [...sitesParSecteur().entries()];
const autreMetier = typoFr(
  'Votre métier n’est pas encore dans les modèles ? Le site se construit de la même façon : appelez-moi pour en parler.',
);
---

<Perso titre="Modèles" description="Modèles de sites vitrines par métier, en trois gammes : Essentiel, Vitrine et Premium.">
  <BandeauPage titre="Modèles">
    <p class="intro-section">
      Pour chaque métier, le même commerce en trois tailles de site : Essentiel, Vitrine et Premium. Ouvrez un modèle et
      parcourez-le comme un vrai site. Les entreprises sont fictives. Votre site reprendra vos informations, vos horaires
      et vos photos.
    </p>
    <p class="lien-tarifs"><a href={LIEN_TARIFS}>Comparer les gammes et les prix</a></p>
  </BandeauPage>
  <div class="suite-page">

  <div class="page page-large rubriques">
    {secteurs.map(([secteur, sites]) => <Rubrique secteur={secteur} sites={sites} niveau={2} />)}
    <p class="autre-metier">{autreMetier}</p>
  </div>
  </div>
</Perso>

<style>
  .autre-metier {
    margin-top: 2.5rem;
    max-width: 40rem;
  }

  .lien-tarifs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    margin-top: 0.5rem;
    font-weight: var(--graisse-forte);
  }

  .rubriques {
    margin-top: 2.5rem;
  }

</style>
