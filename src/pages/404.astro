---
import Neutre from '../layouts/Neutre.astro';
import { LIEN_GRILLE } from '../lib/liens';
---

<Neutre titre="Page introuvable">
  <div class="introuvable">
    <p class="code chiffres">404</p>
    <h1>Cette page n’existe pas</h1>
    <p>L’adresse est peut-être mal saisie, ou la page a été déplacée.</p>
    <p><a href={LIEN_GRILLE}>Revenir à la liste des modèles</a></p>
  </div>
</Neutre>

<style>
  .introuvable > * + * {
    margin-top: 1rem;
  }

  .code {
    font-size: 0.9375rem;
    color: var(--couleur-texte-secondaire);
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
  }

  a {
    display: inline-block;
    padding-block: 0.6rem;
    font-weight: 600;
  }
</style>
