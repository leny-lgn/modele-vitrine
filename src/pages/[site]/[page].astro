---
// Une page par entrée de `pages` dans le fichier du site (hors accueil).
import Base from '../../layouts/Base.astro';
import Provisoire from '../../components/commun/Provisoire.astro';
import ServicesVitrine from '../../layouts/vitrine/Services.astro';
import TarifsVitrine from '../../layouts/vitrine/TarifsPage.astro';
import RealisationsVitrine from '../../layouts/vitrine/Realisations.astro';
import ContactVitrine from '../../layouts/vitrine/Contact.astro';
import { tousLesSites } from '../../lib/sites';
import { LIBELLES_PAGES } from '../../lib/secteurs';
import type { Site, CleePage, Gamme } from '../../lib/schema';

export function getStaticPaths() {
  return tousLesSites().flatMap((site) =>
    site.pages
      .filter((page) => page !== 'accueil')
      .map((page) => ({ params: { site: site.slug, page }, props: { site, page } })),
  );
}

const { site, page } = Astro.props as { site: Site; page: CleePage };

// Pages construites, par gamme. Les autres restent provisoires.
const PAGES: Partial<Record<Gamme, Partial<Record<CleePage, any>>>> = {
  vitrine: {
    services: ServicesVitrine,
    tarifs: TarifsVitrine,
    realisations: RealisationsVitrine,
    contact: ContactVitrine,
  },
};
const Page = PAGES[site.gamme]?.[page];
---

{
  Page ? (
    <Page site={site} />
  ) : (
    <Base site={site} page={page} titre={LIBELLES_PAGES[page]}>
      <Provisoire site={site} page={page} />
    </Base>
  )
}
