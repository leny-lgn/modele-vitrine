// Configuration Cloudflare Workers (static assets) pour les démos.
// Dans Cloudflare : Workers & Pages > Créer > Importer un dépôt Git (Workers Builds)
//   Commande de build  : npm run build
//   Commande de deploy : npx wrangler deploy
{
  "name": "modele-vitrine",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
